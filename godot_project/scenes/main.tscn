; Phase B.1.5: FlatGround HIDDEN — terrain mesh from TerrainBaker replaces it.
; Keep the node (visible=false) as a safety net in case terrain trimesh has gaps.
; The terrain mesh provides visual ground + trimesh collision.
[node name="FlatGround" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2000, -10, 1500)

[node name="FlatGroundMesh" type="MeshInstance3D" parent="FlatGround"]
visible = false
mesh = SubResource("flat_ground_mesh")
material_override = SubResource("flat_ground_mat")

[node name="FlatGroundCollider" type="CollisionShape3D" parent="FlatGround"]
shape = SubResource("flat_ground_col")

; Phase A.4 river test: Player spawns at (2250, 5, 1500) — directly over
; the river centerline at z=1500 (a control point in the polyline). Y=5 puts
; them 5m above the water surface, they fall in. To revert to the original
; suburbia spawn at (1250, 2, 2250), swap the transform below.
[node name="Player" type="CharacterBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2250, 5, 1500)
script = ExtResource("3_player")

