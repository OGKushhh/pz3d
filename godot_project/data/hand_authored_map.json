    { "name": "The Broadcast Tower",          "district": "commercial",  "pos": [2200, 1600], "type": "hero" },
    { "name": "The Hospital",                 "district": "downtown",    "pos": [3200, 900],  "type": "hero" },
    { "name": "The Police HQ",                "district": "downtown",    "pos": [3400, 1000], "type": "hero" },
    { "name": "The Government Palace",        "district": "downtown",    "pos": [3500, 1100], "type": "hero" },
