{
  "_meta": {
    "description": "Hand-authored map data — for side test only. Does NOT replace city_gen_v2.gd (procedural gen stays as-is).",
    "purpose": "Lets us test what a hand-authored city layout feels like vs procedural, while still using BlockRecipes to fill buildings within each district.",
    "version": "1.0",
    "created": "2026-09-21",
    "notes": [
      "Map size: 4000 x 3000 m = 12 km²",
      "9 districts (forest, suburbia, parks, farmland, industrial, downtown, commercial, coastal, military)",
      "Each district has center + radius + shape + notes",
      "Landmarks are placed at exact positions",
      "Highways are polyline paths (list of waypoints)",
      "Coastal road runs along south edge",
      "Military bridge is single-access to Fort Sarran peninsula"
    ]
  },
  "map_size": [4000, 3000],

  "districts": [
    {
      "name": "forest",
      "center": [2000, 200],
      "radius": 500,
      "extends_to_edge": ["north"],
      "shape": "horizontal_strip",
      "notes": "dense pines, logging camps, hunting cabins"
    },
    {
      "name": "suburbia",
      "center": [400, 900],
      "radius": 450,
      "shape": "grid_neighborhood",
      "notes": "residential, cul-de-sacs, starter zone"
    },
    {
      "name": "parks",
      "center": [1600, 600],
      "radius": 350,
      "shape": "irregular_green",
      "notes": "tree-lined, playgrounds, subway entrance"
    },
    {
      "name": "farmland",
      "center": [1400, 900],
      "radius": 400,
      "shape": "large_lots",
      "notes": "crops, barns, low density"
    },
    {
      "name": "industrial",
      "center": [3200, 400],
      "radius": 500,
      "shape": "large_blocks",
      "notes": "warehouses, rail, power plant"
    },
    {
      "name": "downtown",
      "center": [3300, 1000],
      "radius": 400,
      "shape": "dense_grid",
      "notes": "tall buildings, civic landmarks"
    },
    {
      "name": "commercial",
      "center": [2000, 1300],
      "radius": 500,
      "shape": "strip_diagonal",
