{
  "_meta": {
    "source": "Hand-crafted design targets (NOT VLM extraction)",
    "purpose": "Intentional profiles describing what each district SHOULD look like. Loop 3 measures distance from generated plan to these targets.",
    "method": "Each value chosen based on what makes the district BELIEVABLE as a real-world place, not what a VLM guessed from a photo.",
    "normalization": {
      "density": "buildings per 1000m², normalized by MAX_DENSITY=5.0",
      "foliage": "foliage per 1000m², normalized by MAX_FOLIAGE=30.0",
      "prop_density": "props per 1000m², normalized by MAX_PROP_DENSITY=20.0",
      "diversity": "unique asset types / total buildings (already 0..1)",
      "height_proxy": "avg footprint size in m², normalized by MAX_HEIGHT_PROXY=100.0",
      "road_coverage": "0..1, fraction of block covered by roads (estimated)"
    }
  },

