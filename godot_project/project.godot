; Engine configuration file for Mazar Alpha

config_version=5

[application]

config/name="Mazar Alpha"
config/description="First-person 3D survival game inspired by Project Zomboid"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
DebugHUD="*res://tools/debug_hud.gd"
SignalBus="*res://tools/signal_bus.gd"
RenderValidator="*res://weapons/render_validator.gd"
Audio="*res://scripts/audio_autoload.gd"
InputHelper="*res://addons/input_helper/input_helper.gd"
DebugLine="*res://addons/cogito/Scripts/debug_line.gd"
CogitoGlobals="*res://addons/cogito/cogito_globals.gd"
CogitoGameConfig="*res://addons/cogito/Scripts/cogito_game_config.gd"
CogitoSceneManager="*res://addons/cogito/SceneManagement/cogito_scene_manager.gd"
CogitoQuestManager="*res://addons/cogito/QuestSystem/cogito_quest_manager.gd"
MenuTemplateManager="*res://addons/cogito/EasyMenus/Scripts/menu_template_manager.gd"
InputRouter="*res://addons/cogito/Scripts/input_router.gd"
[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="target"
3d_physics/layer_4="weapon"
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.12, 1)
lights_and_shadows/directional_shadow/size=1024

[input]
