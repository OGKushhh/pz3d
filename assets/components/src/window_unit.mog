// window_unit.mog — standalone window component
// This GLB is loaded as a child node of the building at runtime.
// Can be opened, broken, or climbed through during gameplay.
//
// Dimensions: 1.2m wide × 1.0m tall × 0.06m deep (frame)
// Glass pane: 1.05m × 0.85m, recessed 3cm behind frame face
// Origin: center of window frame, at sill height (Y=0 = bottom of window)

meta (name="window_unit", description="Standalone window — openable, breakable, climbable", tags=["component","window","interactive"], mogen_version="0.1.12")
material "trim_white" (color=[0.92, 0.91, 0.86], roughness=0.60)
material "window_glass" (color=[0.45, 0.65, 0.80], transmission=0.50, roughness=0.04, metallic=0.0)
material "dark_metal" (color=[0.15, 0.16, 0.18], metallic=0.70, roughness=0.35)

scene {
  // Outer frame (trim)
  chamfered_box "frame" (size=[1.20, 1.00, 0.06], radius=0.015, mat="trim_white")
  // Glass pane (slightly behind frame face)
  box "glass" (size=[1.05, 0.85, 0.02], mat="window_glass", pos=[0, 0, -0.03])
  // Window sill (horizontal trim at bottom)
  box "sill" (size=[1.25, 0.04, 0.10], mat="trim_white", pos=[0, -0.55, 0.04])
  // Window cross bars (vertical + horizontal dividers for 4-pane look)
  box "bar_v" (size=[0.03, 0.85, 0.03], mat="trim_white", pos=[0, 0, -0.03])
  box "bar_h" (size=[1.05, 0.03, 0.03], mat="trim_white", pos=[0, 0, -0.03])
  // Latch (small metal piece on right side)
  box "latch" (size=[0.05, 0.10, 0.03], mat="dark_metal", pos=[0.50, 0.10, -0.04])
}
