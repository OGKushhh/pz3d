// corner_store.mog — Tier 1 building variant
// Small neighborhood corner store: storefront with big window + door, flat roof.
// Target: 2,500 tris (Low-preset LOD0). Actual: ~1.5k tris.
// Dimensions: 8.0m wide × 6.0m deep × 3.5m tall.

meta (
  name          = "corner_store",
  description   = "Small neighborhood corner store with storefront window",
  tags          = ["building", "store", "commercial", "corner", "tier1"],
  mogen_version = "0.1.12"
)

material "wall_stucco"   (color=[0.70, 0.65, 0.55], roughness=0.85, uv_mode="tile", uv_scale=3.0)
material "roof_flat"     (color=[0.25, 0.22, 0.20], roughness=0.90)
material "trim_white"    (color=[0.92, 0.91, 0.86], roughness=0.60)
material "storefront_glass" (color=[0.40, 0.55, 0.65], transmission=0.60, roughness=0.05)
material "storefront_frame" (color=[0.20, 0.20, 0.22], roughness=0.50, metallic=0.5)
material "door_glass"    (color=[0.35, 0.50, 0.60], transmission=0.50, roughness=0.05)
material "awning_red"    (color=[0.55, 0.20, 0.15], roughness=0.70)
material "concrete"      (color=[0.55, 0.53, 0.50], roughness=0.90)
material "sign_metal"    (color=[0.85, 0.85, 0.88], metallic=0.85, roughness=0.20)
material "brass"         (color=[0.95, 0.70, 0.25], metallic=0.85, roughness=0.25)

module "storefront_window" () {
  // Big glass window with metal frame
  box "frame_top" (size=[3.50, 0.06, 0.04], mat="storefront_frame", pos=[0, 1.10, 0.10])
  box "frame_bot" (size=[3.50, 0.06, 0.04], mat="storefront_frame", pos=[0, 0.15, 0.10])
  box "frame_l"   (size=[0.06, 1.10, 0.04], mat="storefront_frame", pos=[-1.75, 0.625, 0.10])
  box "frame_r"   (size=[0.06, 1.10, 0.04], mat="storefront_frame", pos=[ 1.75, 0.625, 0.10])
  // Glass pane
  box "glass" (size=[3.40, 0.95, 0.02], mat="storefront_glass", pos=[0, 0.625, 0.11])
}

module "storefront_door" () {
  // Glass door with metal frame
  box "frame_l" (size=[0.06, 2.10, 0.04], mat="storefront_frame", pos=[-0.50, 1.05, 0.10])
  box "frame_r" (size=[0.06, 2.10, 0.04], mat="storefront_frame", pos=[ 0.50, 1.05, 0.10])
  box "frame_t" (size=[1.06, 0.06, 0.04], mat="storefront_frame", pos=[0, 2.15, 0.10])
  // Glass door panel
  box "door_glass" (size=[0.95, 2.05, 0.02], mat="door_glass", pos=[0, 1.05, 0.11])
  // Door handle
  box "handle" (size=[0.04, 0.15, 0.03], mat="brass", pos=[0.40, 1.05, 0.13], tags="floating")
}

scene {
  // Foundation + ground
  slab "ground" (size=[14.0, 0.04, 10.0], mat="concrete")
  slab "foundation" (size=[8.4, 0.20, 6.4], mat="concrete", pos=[0, 0.02, 0])

  // === WALLS ===
  // Front wall — big storefront window (left) + door (right)
  wall "front_wall" (
    size=[8.0, 3.10, 0.20],
    pos=[0, 1.75, -3.0],
    holes=[
      // Storefront window: 3.5 wide × 1.1 tall, on the left
      [-2.00, -0.625, 3.50, 1.10],
      // Door: 1.0 wide × 2.1 tall, on the right
      [1.50, -0.05, 1.00, 2.10],
    ]
  )

  // Back wall — 1 window + 1 door (staff entrance)
  wall "back_wall" (
    size=[8.0, 3.10, 0.20],
    pos=[0, 1.75, 3.0],
    holes=[
      [-2.50, 0.10, 1.00, 0.80],
      [ 2.50, -0.05, 0.90, 2.00],
    ]
  )

  // Left wall — 1 window
  wall "left_wall" (
    size=[6.0, 3.10, 0.20],
    pos=[-4.0, 1.75, 0],
    rot=[0, 90, 0],
    holes=[
      [0.0, 0.10, 1.20, 1.00],
    ]
  )

  // Right wall — 1 window
  wall "right_wall" (
    size=[6.0, 3.10, 0.20],
    pos=[4.0, 1.75, 0],
    rot=[0, 90, 0],
    holes=[
      [0.0, 0.10, 1.20, 1.00],
    ]
  )

  // Floor + ceiling
  slab "floor" (size=[8.0, 0.10, 6.0], mat="concrete", pos=[0, 0.20, 0])
  slab "ceiling" (size=[8.0, 0.10, 6.0], mat="wall_stucco", pos=[0, 3.30, 0])

  // === FLAT ROOF (with slight parapet) ===
  slab "roof" (size=[8.4, 0.10, 6.4], mat="roof_flat", pos=[0, 3.40, 0])
  // Parapet (low wall around roof edge)
  box "parapet_front" (size=[8.4, 0.25, 0.10], mat="wall_stucco", pos=[0, 3.60, -3.20], tags="floating")
  box "parapet_back"  (size=[8.4, 0.25, 0.10], mat="wall_stucco", pos=[0, 3.60,  3.20], tags="floating")
  box "parapet_left"  (size=[0.10, 0.25, 6.4], mat="wall_stucco", pos=[-4.20, 3.60, 0], tags="floating")
  box "parapet_right" (size=[0.10, 0.25, 6.4], mat="wall_stucco", pos=[ 4.20, 3.60, 0], tags="floating")

  // === STOREFRONT WINDOW + DOOR ===
  // Window: center at world (-2.0, 1.125, -3.0)
  group "storefront_window_group" (pos=[-2.00, 1.125, -3.0]) { use "storefront_window" () }
  // Door: center at world (1.5, 1.05, -3.0)
  group "storefront_door_group" (pos=[1.50, 1.05, -3.0]) { use "storefront_door" () }

  // === AWNING (red striped awning above storefront) ===
  box "awning" (size=[5.00, 0.05, 1.20], mat="awning_red", pos=[-0.50, 2.30, -3.50], tags="floating")
  // Awning support rods (2 thin rods from wall to awning front)
  cylinder "rod_l" (radius=0.015, height=0.40, segments=8, mat="sign_metal", pos=[-2.50, 2.20, -3.70], rot=[60, 0, 0], tags="floating")
  cylinder "rod_r" (radius=0.015, height=0.40, segments=8, mat="sign_metal", pos=[ 1.50, 2.20, -3.70], rot=[60, 0, 0], tags="floating")

  // === STORE SIGN (blank sign panel above awning) ===
  box "sign_panel" (size=[4.00, 0.50, 0.05], mat="sign_metal", pos=[-0.50, 2.65, -3.10], tags="floating")

  // === BACK WINDOWS + DOOR ===
  group "back_window_group" (pos=[-2.50, 1.85, 3.0]) { use "storefront_window" () }
  group "back_door_group" (pos=[2.50, 1.05, 3.0]) { use "storefront_door" () }

  // === SIDE WINDOWS (rotated to align with rotated walls) ===
  group "left_window_group" (pos=[-4.0, 1.85, 0], rot=[0, 90, 0]) { use "storefront_window" () }
  group "right_window_group" (pos=[4.0, 1.85, 0], rot=[0, 90, 0]) { use "storefront_window" () }

  // === DOOR STEP ===
  slab "door_step" (size=[1.20, 0.06, 0.30], mat="concrete", pos=[1.50, 0.03, -3.20], tags="floating")
}
