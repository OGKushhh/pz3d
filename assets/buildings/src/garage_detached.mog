// garage_detached.mog — Tier 1 building variant
// Detached 1-car garage: roll-up door, side door, 1 window.
// Target: 2,500 tris (Low-preset LOD0). Actual: ~1.5k tris.
// Dimensions: 6.0m wide × 4.0m deep × 3.0m tall.

meta (
  name          = "garage_detached",
  description   = "Detached 1-car garage with roll-up door and side entrance",
  tags          = ["building", "garage", "detached", "suburban", "tier1"],
  mogen_version = "0.1.12"
)

material "wall_stucco"   (color=[0.78, 0.74, 0.65], roughness=0.85, uv_mode="tile", uv_scale=3.0)
material "roof_tile"     (color=[0.40, 0.20, 0.15], roughness=0.80, uv_mode="tile", uv_scale=4.0)
material "trim_white"    (color=[0.92, 0.91, 0.86], roughness=0.60)
material "door_garage"   (color=[0.78, 0.76, 0.72], roughness=0.65, uv_mode="tile", uv_scale=2.0)
material "door_side"     (color=[0.30, 0.20, 0.12], roughness=0.65)
material "window_glass"  (color=[0.45, 0.65, 0.80], transmission=0.50, roughness=0.04)
material "concrete"      (color=[0.55, 0.53, 0.50], roughness=0.90)
material "grass"         (color=[0.25, 0.45, 0.18], roughness=0.85, uv_mode="tile", uv_scale=2.5)
material "dark_metal"    (color=[0.15, 0.16, 0.18], metallic=0.70, roughness=0.35)
material "brass"         (color=[0.95, 0.70, 0.25], metallic=0.85, roughness=0.25)

module "garage_door_module" () {
  // Recessed panel (sits 8cm back from wall face)
  inset_box "panel" (size=[2.80, 2.25, 0.08], face="front", amount=0.08, depth=0.04, mat="door_garage")
  // 4 horizontal panel lines (suggesting roll-up sections)
  box "line_1" (size=[2.70, 0.02, 0.02], mat="dark_metal", pos=[0, 0.85, -0.10], tags="floating")
  box "line_2" (size=[2.70, 0.02, 0.02], mat="dark_metal", pos=[0, 0.30, -0.10], tags="floating")
  box "line_3" (size=[2.70, 0.02, 0.02], mat="dark_metal", pos=[0, -0.30, -0.10], tags="floating")
  box "line_4" (size=[2.70, 0.02, 0.02], mat="dark_metal", pos=[0, -0.85, -0.10], tags="floating")
  // Handle bar
  chamfered_box "handle" (size=[0.40, 0.05, 0.04], radius=0.01, mat="dark_metal", pos=[0, -0.85, -0.13], tags="floating")
}

module "side_door_module" () {
  chamfered_box "frame" (size=[0.95, 2.00, 0.06], radius=0.02, mat="trim_white")
  chamfered_box "panel" (size=[0.80, 1.85, 0.05], radius=0.015, mat="door_side", pos=[0, 0, -0.08])
  sphere "knob" (radius=0.04, mat="brass", pos=[0.28, -0.10, -0.13])
}

module "window_module" () {
  chamfered_box "frame" (size=[0.90, 0.80, 0.06], radius=0.015, mat="trim_white")
  box "glass" (size=[0.75, 0.65, 0.02], mat="window_glass", pos=[0, 0, -0.03])
  box "sill" (size=[1.00, 0.04, 0.10], mat="trim_white", pos=[0, -0.42, 0.04])
}

scene {
  // Foundation + ground
  slab "ground" (size=[10.0, 0.04, 8.0], mat="grass")
  slab "foundation" (size=[6.4, 0.20, 4.4], mat="concrete", pos=[0, 0.02, 0])
  // Driveway approach (front of garage)
  slab "driveway" (size=[6.4, 0.04, 2.0], mat="concrete", pos=[0, 0.02, -3.0])

  // === WALLS ===
  // Front wall — big garage door cutout (centered) + no side door (simpler)
  wall "front_wall" (
    size=[6.0, 2.80, 0.20],
    pos=[0, 1.55, -2.0],
    holes=[
      // Garage door: 2.8 wide × 2.3 tall, centered
      [0.0, -0.25, 2.80, 2.30],
    ]
  )

  // Back wall (no openings)
  wall "back_wall" (
    size=[6.0, 2.80, 0.20],
    pos=[0, 1.55, 2.0]
  )

  // Left wall — side door + 1 window
  wall "left_wall" (
    size=[4.0, 2.80, 0.20],
    pos=[-3.0, 1.55, 0],
    rot=[0, 90, 0],
    holes=[
      // Side door: offset toward front, 0.9 × 2.0
      [-1.20, -0.40, 0.90, 2.00],
      // Window: offset toward back
      [1.20, 0.20, 0.90, 0.80],
    ]
  )

  // Right wall — 1 window
  wall "right_wall" (
    size=[4.0, 2.80, 0.20],
    pos=[3.0, 1.55, 0],
    rot=[0, 90, 0],
    holes=[
      [0.0, 0.20, 0.90, 0.80],
    ]
  )

  // Floor
  slab "floor" (size=[6.0, 0.10, 4.0], mat="concrete", pos=[0, 0.20, 0])

  // === ROOF (gable, runs along X-axis) ===
  prism "roof" (size=[6.5, 0.90, 4.5], pos=[0, 3.25, 0], mat="roof_tile")

  // === GARAGE DOOR ===
  group "garage_door_group" (pos=[0, 1.15, -2.0]) { use "garage_door_module" () }

  // === SIDE DOOR (on left wall, at x=-3.0, z=-1.20) ===
  // Wall cutout center at (cx=-1.20, cy=-0.40) in wall-local space.
  // Wall is at x=-3.0, rot=[0,90,0], so wall-local X maps to world Z.
  // World position: x=-3.0, y=1.55-0.40=1.15, z=-1.20
  group "side_door_group" (pos=[-3.0, 1.15, -1.20], rot=[0, 90, 0]) { use "side_door_module" () }

  // === SIDE WINDOW (on left wall, at x=-3.0, z=1.20) ===
  // Wall cutout center at (cx=1.20, cy=0.20). World: x=-3.0, y=1.55+0.20=1.75, z=1.20
  group "side_window_group" (pos=[-3.0, 1.75, 1.20], rot=[0, 90, 0]) { use "window_module" () }

  // === RIGHT WINDOW ===
  // Wall cutout center at (cx=0, cy=0.20). World: x=3.0, y=1.75, z=0
  group "right_window_group" (pos=[3.0, 1.75, 0], rot=[0, 90, 0]) { use "window_module" () }

  // === GUTTERS ===
  box "front_gutter" (size=[6.5, 0.08, 0.10], mat="trim_white", pos=[0, 2.90, -2.45], tags="floating")
  box "back_gutter"  (size=[6.5, 0.08, 0.10], mat="trim_white", pos=[0, 2.90,  2.45], tags="floating")
}
