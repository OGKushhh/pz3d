meta (name="store_gun", description="Gun store", tags=["building","store","gun","commercial","tier1"], mogen_version="0.1.12")
material "wall_brick" (color=[0.45, 0.25, 0.18], roughness=0.88, uv_mode="tile", uv_scale=3.0)
material "roof_flat" (color=[0.25, 0.22, 0.20], roughness=0.90)
material "trim_dark" (color=[0.15, 0.15, 0.18], roughness=0.50, metallic=0.6)
material "storefront_glass" (color=[0.20, 0.25, 0.30], roughness=0.10, metallic=0.3)
material "door_metal" (color=[0.30, 0.30, 0.32], roughness=0.40, metallic=0.7)
material "concrete" (color=[0.55, 0.53, 0.50], roughness=0.90)
material "asphalt" (color=[0.18, 0.18, 0.20], roughness=0.95)
module "win" () { box "frame" (size=[1.50, 1.00, 0.04], mat="trim_dark") box "glass" (size=[1.35, 0.85, 0.02], mat="storefront_glass", pos=[0,0,-0.03]) }
module "dr" () { box "frame" (size=[1.10, 2.10, 0.06], mat="trim_dark") box "panel" (size=[0.95, 1.95, 0.05], mat="door_metal", pos=[0,0,-0.05]) }
scene {
  slab "ground" (size=[12.0, 0.04, 10.0], mat="asphalt")
  slab "foundation" (size=[6.4, 0.20, 6.4], mat="concrete", pos=[0, 0.02, 0])
  wall "front_wall" (size=[6.0, 3.00, 0.20], pos=[0, 1.70, -3.0], holes=[[-1.50, -0.10, 1.10, 2.10], [1.50, 0.30, 1.50, 1.00]])
  wall "back_wall" (size=[6.0, 3.00, 0.20], pos=[0, 1.70, 3.0])
  wall "left_wall" (size=[6.0, 3.00, 0.20], pos=[-3.0, 1.70, 0], rot=[0, 90, 0])
  wall "right_wall" (size=[6.0, 3.00, 0.20], pos=[3.0, 1.70, 0], rot=[0, 90, 0])
  slab "floor" (size=[6.0, 0.10, 6.0], mat="concrete", pos=[0, 0.20, 0])
  slab "ceiling" (size=[6.0, 0.10, 6.0], mat="wall_brick", pos=[0, 3.10, 0])
  slab "roof" (size=[6.4, 0.10, 6.4], mat="roof_flat", pos=[0, 3.25, 0], tags="floating")
  group "dr" (pos=[-1.50, 1.05, -3.0]) { use "dr" () }
  group "wf" (pos=[1.50, 1.80, -3.0]) { use "win" () }
}
