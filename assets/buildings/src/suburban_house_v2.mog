// suburban_house_v2.mog — Tier 1 Style Anchor #1
// Fixes from v1 (upstream example):
//   1. Door bug fixed — door is recessed 8cm into the wall via `wall` primitive
//      with `holes=[...]` cutout, then a recessed door panel sits in the cavity.
//      Door is now visible from any front angle.
//   2. Door frame added (chamfered_box trim around the door cavity).
//   3. Porch roof is shorter — does not occlude the door from front view.
//   4. Garage door uses same `wall` cutout approach — visible + recessed.
//   5. Materials are Mazar-themed: cream walls, terracotta roof, dark trim.
//
// Poly budget: 8000 tris LOD0 (per locked budget).
// Dimensions: 8.0 m wide × 6.0 m deep × 4.5 m tall (main body) + 3.5 m garage
// Coordinate system: glTF (right-handed, +Y up, -Z forward).
// Front of house faces -Z (toward camera in default thumbnail).

meta (
  name          = "suburban_house_v2",
  description   = "Mazar suburban house with recessed door, frame, and visible garage door",
  tags          = ["building", "house", "suburban", "mazar", "tier1"],
  mogen_version = "0.1.12"
)

// === MATERIALS (Mazar palette — cream walls, terracotta roof, dark trim) ===
material "wall_stucco"   (color=[0.86, 0.82, 0.72], roughness=0.85, uv_mode="tile", uv_scale=3.0)
material "roof_tile"     (color=[0.55, 0.22, 0.15], roughness=0.80, uv_mode="tile", uv_scale=4.0)
material "trim_white"    (color=[0.92, 0.91, 0.86], roughness=0.60)
material "window_glass"  (color=[0.45, 0.65, 0.80], transmission=0.50, roughness=0.04, metallic=0.0)
material "door_red"      (color=[0.55, 0.10, 0.08], roughness=0.55)
material "door_garage"   (color=[0.78, 0.76, 0.72], roughness=0.65, uv_mode="tile", uv_scale=2.0)
material "brass"         (color=[0.95, 0.70, 0.25], metallic=0.85, roughness=0.25)
material "concrete"      (color=[0.55, 0.53, 0.50], roughness=0.90, uv_mode="tile", uv_scale=1.2)
material "grass"         (color=[0.25, 0.45, 0.18], roughness=0.85, uv_mode="tile", uv_scale=2.5)
material "dark_metal"    (color=[0.15, 0.16, 0.18], metallic=0.70, roughness=0.35)
material "brick_chimney" (color=[0.50, 0.20, 0.14], roughness=0.85, uv_mode="tile", uv_scale=3.0)

// === REUSABLE MODULES ===

// Standard window: recessed glass + frame, mounted on a wall cutout.
// Cutout dimensions: 1.2 m wide × 1.0 m tall.
module "window_unit" () {
  // Outer frame (trim)
  chamfered_box "frame" (size=[1.20, 1.00, 0.06], radius=0.015, mat="trim_white")
  // Glass pane (slightly behind frame face)
  box "glass" (size=[1.05, 0.85, 0.02], mat="window_glass", pos=[0, 0, -0.03])
  // Inner sill
  box "sill" (size=[1.25, 0.04, 0.10], mat="trim_white", pos=[0, -0.55, 0.04])
}

// Front door: recessed panel + frame + doorknob. Door cutout: 1.0 m × 2.10 m.
module "front_door" () {
  // Outer frame (trim around the cavity)
  chamfered_box "frame" (size=[1.10, 2.20, 0.06], radius=0.02, mat="trim_white")
  // Recessed door panel (sits 8 cm back from wall face)
  chamfered_box "panel" (size=[0.95, 2.05, 0.05], radius=0.015, mat="door_red", pos=[0, 0, -0.08])
  // Doorknob (brass sphere)
  sphere "knob" (radius=0.04, mat="brass", pos=[0.32, -0.10, -0.13])
}

// Garage door: panel + handle. Cutout: 2.6 m × 2.2 m.
module "garage_door_unit" () {
  // Recessed panel (sits 8 cm back)
  inset_box "panel" (size=[2.55, 2.15, 0.08], face="front", amount=0.08, depth=0.04, mat="door_garage")
  // Handle bar (slightly recessed into the panel, not floating in front)
  chamfered_box "handle" (size=[0.40, 0.05, 0.04], radius=0.01, mat="dark_metal", pos=[0, -0.55, -0.06])
}

// === SCENE ===

scene {
  // --- FOUNDATION + LAWN ---
  slab "lawn" (size=[14.0, 0.04, 10.0], mat="grass", pos=[0, 0, 0])
  slab "foundation" (size=[9.0, 0.20, 6.0], mat="concrete", pos=[0, 0.10, 0])
  slab "driveway" (size=[3.5, 0.04, 4.0], mat="concrete", pos=[3.8, 0.02, -3.5])

  // --- MAIN BODY (with cutouts for doors + windows via `wall` primitive) ---
  // The `wall` node = a box with rectangular holes cut all the way through Z.
  // Each hole is [cx, cy, w, h] in the wall's local X/Y plane.
  // We build 4 walls (front, back, left, right) and a floor + ceiling to make
  // a watertight shell. Solid groups them at export time.

  solid "main_shell" (mat="wall_stucco", cleanup="coplanar") {
    // Floor slab
    slab "floor" (size=[8.0, 0.10, 6.0], pos=[0, 0.20, 0], mat="concrete")
    // Ceiling slab
    slab "ceiling" (size=[8.0, 0.10, 6.0], pos=[0, 2.65, 0], mat="wall_stucco")

    // FRONT WALL (-Z face, faces camera) — has door + 2 windows
    // Wall is 8.0 wide × 2.55 tall × 0.20 thick
    // Centered on the front face: z = -3.0
    wall "front_wall" (
      size=[8.0, 2.55, 0.20],
      pos=[0, 1.475, -3.0],
      holes=[
        // Front door: centered, 1.0 wide × 2.10 tall, bottom at floor
        [0.0, -0.225, 1.00, 2.10],
        // Window left of door: 1.5 m left, 1.2 × 1.0, centered at y=1.4
        [-2.20, 0.10, 1.20, 1.00],
        // Window right of door: 1.5 m right
        [ 2.20, 0.10, 1.20, 1.00],
      ]
    )

    // BACK WALL (+Z face) — 2 windows
    wall "back_wall" (
      size=[8.0, 2.55, 0.20],
      pos=[0, 1.475, 3.0],
      holes=[
        [-1.80, 0.10, 1.20, 1.00],
        [ 1.80, 0.10, 1.20, 1.00],
      ]
    )

    // LEFT WALL (-X face) — 1 window
    wall "left_wall" (
      size=[6.0, 2.55, 0.20],
      pos=[-4.0, 1.475, 0],
      rot=[0, 90, 0],
      holes=[
        [0.0, 0.10, 1.20, 1.00],
      ]
    )

    // RIGHT WALL (+X face) — connects to garage, 1 window in the back half
    wall "right_wall_back" (
      size=[3.0, 2.55, 0.20],
      pos=[4.0, 1.475, 1.5],
      rot=[0, 90, 0],
      holes=[
        [0.0, 0.10, 1.20, 1.00],
      ]
    )
    // right_wall_front (z=-1.5 to z=0) is replaced by the garage opening
    // — handled by the garage shell below
  }

  // --- GARAGE (attached on +X side, front) ---
  // Garage is 3.5 wide × 4.0 deep × 2.5 tall
  solid "garage_shell" (mat="wall_stucco", cleanup="coplanar") {
    slab "garage_floor" (size=[3.5, 0.10, 4.0], pos=[5.0, 0.20, -1.0], mat="concrete")
    slab "garage_ceiling" (size=[3.5, 0.10, 4.0], pos=[5.0, 2.60, -1.0], mat="wall_stucco")

    // Garage front wall — has the garage door cutout
    wall "garage_front" (
      size=[3.5, 2.50, 0.20],
      pos=[5.0, 1.35, -3.0],
      holes=[
        // Garage door cutout: 2.6 wide × 2.2 tall, centered
        [0.0, -0.15, 2.60, 2.20],
      ]
    )
    // Garage back wall
    wall "garage_back" (
      size=[3.5, 2.50, 0.20],
      pos=[5.0, 1.35, 1.0]
    )
    // Garage right wall (outer)
    wall "garage_right" (
      size=[4.0, 2.50, 0.20],
      pos=[6.75, 1.35, -1.0],
      rot=[0, 90, 0]
    )
  }

  // --- ROOFS ---
  // Main house: gable prism, 0.4 m overhang on all sides
  prism "main_roof" (size=[8.8, 1.4, 6.8], pos=[0, 3.40, 0], mat="roof_tile")
  // Garage: lower gable
  prism "garage_roof" (size=[4.3, 0.9, 4.8], pos=[5.0, 3.20, -1.0], mat="roof_tile")

  // --- WINDOW UNITS (mounted in the cutouts via attach) ---
  // Front wall windows + door
  group "front_door_group" (pos=[0, 1.25, -3.0]) { use "front_door" () }
  group "front_window_l"   (pos=[-2.20, 1.575, -3.0]) { use "window_unit" () }
  group "front_window_r"   (pos=[ 2.20, 1.575, -3.0]) { use "window_unit" () }
  // Back wall windows
  group "back_window_l"   (pos=[-1.80, 1.575, 3.0]) { use "window_unit" () }
  group "back_window_r"   (pos=[ 1.80, 1.575, 3.0]) { use "window_unit" () }
  // Side windows
  group "left_window"     (pos=[-4.0, 1.575, 0], rot=[0, 90, 0]) { use "window_unit" () }
  group "right_window"    (pos=[ 4.0, 1.575, 1.5], rot=[0, 90, 0]) { use "window_unit" () }

  // Garage door
  group "garage_door_group" (pos=[5.0, 1.20, -3.0]) { use "garage_door_unit" () }

  // --- PORCH (smaller — doesn't occlude door) ---
  // Porch slab: 1.4 m × 1.0 m, right in front of door
  slab "porch_slab" (size=[1.40, 0.12, 1.00], mat="concrete", pos=[0, 0.06, -3.5])
  // Porch roof: small gable, 1.6 × 1.2, doesn't extend past door width
  prism "porch_roof" (size=[1.60, 0.20, 1.20], pos=[0, 2.75, -3.5], mat="roof_tile")
  // 2 porch posts (cylinders)
  cylinder "porch_post_l" (radius=0.05, height=2.65, segments=12, mat="trim_white", pos=[-0.65, 1.45, -3.95])
  cylinder "porch_post_r" (radius=0.05, height=2.65, segments=12, mat="trim_white", pos=[ 0.65, 1.45, -3.95])

  // --- CHIMNEY ---
  // Chimney base sits on roof, extends up. Cap is positioned to overlap chimney top so they merge.
  box "chimney" (size=[0.50, 1.40, 0.50], mat="brick_chimney", pos=[1.50, 4.10, 0])
  slab "chimney_cap" (size=[0.60, 0.10, 0.60], mat="concrete", pos=[1.50, 4.75, 0])

  // --- EXTRAS: gutters + downspouts (visual detail) ---
  box "front_gutter" (size=[8.8, 0.08, 0.10], mat="trim_white", pos=[0, 2.75, -3.45])
  box "back_gutter"  (size=[8.8, 0.08, 0.10], mat="trim_white", pos=[0, 2.75,  3.45])

  // --- DOOR STEP (small concrete step in front of door) ---
  slab "door_step" (size=[1.20, 0.06, 0.30], mat="concrete", pos=[0, 0.03, -3.20])
}
