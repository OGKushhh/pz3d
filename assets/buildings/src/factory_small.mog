meta (name="factory_small", description="Small industrial factory with smokestack", tags=["building","factory","industrial","tier1"], mogen_version="0.1.12")
material "wall_metal" (color=[0.45, 0.45, 0.48], roughness=0.60, metallic=0.5, uv_mode="tile", uv_scale=3.0)
material "roof_metal" (color=[0.30, 0.30, 0.32], roughness=0.60, metallic=0.6)
material "trim_dark" (color=[0.15, 0.15, 0.18], roughness=0.50, metallic=0.7)
material "window_glass" (color=[0.25, 0.30, 0.35], roughness=0.10, metallic=0.3)
material "door_metal" (color=[0.35, 0.35, 0.38], roughness=0.40, metallic=0.6)
material "concrete" (color=[0.55, 0.53, 0.50], roughness=0.90)
material "asphalt" (color=[0.18, 0.18, 0.20], roughness=0.95)
material "brick_chimney" (color=[0.40, 0.20, 0.12], roughness=0.85, uv_mode="tile", uv_scale=3.0)
module "win" () { box "frame" (size=[1.50, 1.00, 0.04], mat="trim_dark") box "glass" (size=[1.35, 0.85, 0.02], mat="window_glass", pos=[0,0,-0.03]) }
module "dr" () { box "frame" (size=[3.00, 3.00, 0.06], mat="trim_dark") box "panel" (size=[2.85, 2.85, 0.05], mat="door_metal", pos=[0,0,-0.05]) }
scene {
  slab "ground" (size=[20.0, 0.04, 16.0], mat="asphalt")
  slab "foundation" (size=[12.4, 0.20, 8.4], mat="concrete", pos=[0, 0.02, 0])
  wall "front_wall" (size=[12.0, 4.00, 0.20], pos=[0, 2.20, -4.0], holes=[[0.0, -0.50, 3.00, 3.00], [-4.00, 0.50, 1.50, 1.00], [4.00, 0.50, 1.50, 1.00]])
  wall "back_wall" (size=[12.0, 4.00, 0.20], pos=[0, 2.20, 4.0], holes=[[-3.00, 0.50, 1.50, 1.00], [3.00, 0.50, 1.50, 1.00]])
  wall "left_wall" (size=[8.0, 4.00, 0.20], pos=[-6.0, 2.20, 0], rot=[0, 90, 0], holes=[[-2.00, 0.50, 1.50, 1.00], [2.00, 0.50, 1.50, 1.00]])
  wall "right_wall" (size=[8.0, 4.00, 0.20], pos=[6.0, 2.20, 0], rot=[0, 90, 0], holes=[[-2.00, 0.50, 1.50, 1.00], [2.00, 0.50, 1.50, 1.00]])
  slab "floor" (size=[12.0, 0.10, 8.0], mat="concrete", pos=[0, 0.20, 0])
  slab "ceiling" (size=[12.0, 0.10, 8.0], mat="wall_metal", pos=[0, 4.10, 0])
  slab "roof" (size=[12.4, 0.10, 8.4], mat="roof_metal", pos=[0, 4.25, 0], tags="floating")
  group "dr" (pos=[0, 0.80, -4.0]) { use "dr" () }
  group "wf_l" (pos=[-4.00, 2.20, -4.0]) { use "win" () }
  group "wf_r" (pos=[4.00, 2.20, -4.0]) { use "win" () }
  group "wb_l" (pos=[-3.00, 2.20, 4.0]) { use "win" () }
  group "wb_r" (pos=[3.00, 2.20, 4.0]) { use "win" () }
  group "wl_1" (pos=[-6.0, 2.20, -2.00], rot=[0,90,0]) { use "win" () }
  group "wl_2" (pos=[-6.0, 2.20, 2.00], rot=[0,90,0]) { use "win" () }
  group "wr_1" (pos=[6.0, 2.20, -2.00], rot=[0,90,0]) { use "win" () }
  group "wr_2" (pos=[6.0, 2.20, 2.00], rot=[0,90,0]) { use "win" () }
  box "chimney" (size=[0.60, 2.00, 0.60], mat="brick_chimney", pos=[3.00, 5.25, 0], tags="floating")
