// gas_station.mog — Gas station with canopy + pumps + small store
meta (name="gas_station", description="Gas station with canopy, pumps, and small store", tags=["building","gas_station","commercial","tier1"], mogen_version="0.1.12")
material "wall_stucco" (color=[0.75,0.70,0.60], roughness=0.85, uv_mode="tile", uv_scale=3.0)
material "roof_flat" (color=[0.25,0.22,0.20], roughness=0.90)
material "canopy_red" (color=[0.55,0.20,0.15], roughness=0.60)
material "trim_white" (color=[0.92,0.91,0.86], roughness=0.60)
material "window_glass" (color=[0.40,0.55,0.65], transmission=0.50, roughness=0.04)
material "door_glass" (color=[0.35,0.50,0.60], transmission=0.50, roughness=0.05)
material "pump_metal" (color=[0.20,0.22,0.25], roughness=0.40, metallic=0.6)
material "pump_screen" (color=[0.10,0.15,0.20], roughness=0.10, emissive=[0.2,0.3,0.4], emissive_strength=0.5)
material "concrete" (color=[0.55,0.53,0.50], roughness=0.90)
material "asphalt" (color=[0.18,0.18,0.20], roughness=0.95)
material "brass" (color=[0.95,0.70,0.25], metallic=0.85, roughness=0.25)

module "gas_window" () {
  chamfered_box "frame" (size=[1.20, 1.00, 0.06], radius=0.015, mat="trim_white")
  box "glass" (size=[1.05, 0.85, 0.02], mat="window_glass", pos=[0,0,-0.03])
}

module "gas_door" () {
  chamfered_box "frame" (size=[1.00, 2.10, 0.06], radius=0.02, mat="trim_white")
  box "glass" (size=[0.85, 1.95, 0.02], mat="door_glass", pos=[0,0,-0.05])
  box "handle" (size=[0.04, 0.15, 0.03], mat="brass", pos=[0.30, 0, 0.07], tags="floating")
}

scene {
  slab "ground" (size=[20.0, 0.04, 16.0], mat="asphalt")
  slab "foundation" (size=[8.4, 0.20, 6.4], mat="concrete", pos=[0, 0.02, 2.0])

  // === STORE (small building at back) ===
  wall "front_wall" (size=[8.0, 3.10, 0.20], pos=[0, 1.75, -1.0], holes=[
    [-2.50, -0.05, 1.00, 2.10],  // Door
    [ 2.00, 0.20, 1.20, 1.00],  // Window
  ])
  wall "back_wall" (size=[8.0, 3.10, 0.20], pos=[0, 1.75, 5.0], holes=[
    [-2.50, 0.20, 1.20, 1.00],
    [ 2.50, 0.20, 1.20, 1.00],
  ])
  wall "left_wall" (size=[6.0, 3.10, 0.20], pos=[-4.0, 1.75, 2.0], rot=[0, 90, 0], holes=[
    [0.0, 0.20, 1.20, 1.00],
  ])
  wall "right_wall" (size=[6.0, 3.10, 0.20], pos=[4.0, 1.75, 2.0], rot=[0, 90, 0], holes=[
    [0.0, 0.20, 1.20, 1.00],
  ])
  slab "floor" (size=[8.0, 0.10, 6.0], mat="concrete", pos=[0, 0.20, 2.0])
  slab "ceiling" (size=[8.0, 0.10, 6.0], mat="wall_stucco", pos=[0, 3.30, 2.0])
  slab "roof" (size=[8.4, 0.10, 6.4], mat="roof_flat", pos=[0, 3.45, 2.0])

  // Store door + windows
  group "store_door" (pos=[-2.50, 1.05, -1.0]) { use "gas_door" () }
  group "store_wf" (pos=[ 2.00, 1.95, -1.0]) { use "gas_window" () }
  group "store_wb_l" (pos=[-2.50, 1.95, 5.0]) { use "gas_window" () }
  group "store_wb_r" (pos=[ 2.50, 1.95, 5.0]) { use "gas_window" () }
  group "store_wl" (pos=[-4.0, 1.95, 2.0], rot=[0,90,0]) { use "gas_window" () }
  group "store_wr" (pos=[ 4.0, 1.95, 2.0], rot=[0,90,0]) { use "gas_window" () }

  // === CANOPY (over pump area, in front of store) ===
  // 4 posts + flat roof
  slab "canopy_roof" (size=[8.0, 0.15, 4.0], mat="canopy_red", pos=[0, 4.00, -3.0])
  cylinder "post_fl" (radius=0.08, height=4.00, segments=12, mat="trim_white", pos=[-3.80, 2.00, -4.80])
  cylinder "post_fr" (radius=0.08, height=4.00, segments=12, mat="trim_white", pos=[ 3.80, 2.00, -4.80])
  cylinder "post_bl" (radius=0.08, height=4.00, segments=12, mat="trim_white", pos=[-3.80, 2.00, -1.20])
  cylinder "post_br" (radius=0.08, height=4.00, segments=12, mat="trim_white", pos=[ 3.80, 2.00, -1.20])

  // === 2 GAS PUMPS (under canopy) ===
  group "pump_l" (pos=[-1.50, 0, -3.0]) {
    box "body" (size=[0.50, 1.20, 0.30], mat="pump_metal", pos=[0, 0.60, 0])
    box "screen" (size=[0.35, 0.25, 0.02], mat="pump_screen", pos=[0, 1.00, 0.16], tags="floating")
    box "base" (size=[0.55, 0.05, 0.35], mat="concrete", pos=[0, 0.025, 0])
    // Hose
    cylinder "hose" (radius=0.015, height=1.00, segments=6, mat="pump_metal", pos=[0.30, 0.50, 0], rot=[0, 0, 90], tags="floating")
  }
  group "pump_r" (pos=[1.50, 0, -3.0]) {
    box "body" (size=[0.50, 1.20, 0.30], mat="pump_metal", pos=[0, 0.60, 0])
    box "screen" (size=[0.35, 0.25, 0.02], mat="pump_screen", pos=[0, 1.00, 0.16], tags="floating")
    box "base" (size=[0.55, 0.05, 0.35], mat="concrete", pos=[0, 0.025, 0])
    cylinder "hose" (radius=0.015, height=1.00, segments=6, mat="pump_metal", pos=[0.30, 0.50, 0], rot=[0, 0, 90], tags="floating")
  }
}
