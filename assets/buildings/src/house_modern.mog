// house_modern.mog — Modern flat-roof suburban house
meta (name="house_modern", description="Modern flat-roof suburban house with large windows", tags=["building","house","modern","suburban","tier1"], mogen_version="0.1.12")
material "wall_white" (color=[0.88,0.86,0.82], roughness=0.80, uv_mode="tile", uv_scale=3.0)
material "wall_dark" (color=[0.25,0.25,0.28], roughness=0.80, uv_mode="tile", uv_scale=2.0)
material "roof_flat" (color=[0.20,0.20,0.22], roughness=0.90)
material "trim_grey" (color=[0.40,0.40,0.42], roughness=0.50, metallic=0.5)
material "window_glass" (color=[0.35,0.50,0.60], transmission=0.60, roughness=0.03)
material "door_dark" (color=[0.15,0.15,0.18], roughness=0.50, metallic=0.3)
material "concrete" (color=[0.55,0.53,0.50], roughness=0.90)
material "grass" (color=[0.25,0.45,0.18], roughness=0.85, uv_mode="tile", uv_scale=2.5)
material "brass" (color=[0.95,0.70,0.25], metallic=0.85, roughness=0.25)

module "win_large" () {
  box "frame" (size=[1.60, 1.40, 0.04], mat="trim_grey")
  box "glass" (size=[1.50, 1.30, 0.02], mat="window_glass", pos=[0,0,-0.03])
}
module "win_small" () {
  box "frame" (size=[1.00, 0.80, 0.04], mat="trim_grey")
  box "glass" (size=[0.90, 0.70, 0.02], mat="window_glass", pos=[0,0,-0.03])
}
module "door_modern" () {
  box "frame" (size=[1.10, 2.20, 0.04], mat="trim_grey")
  box "panel" (size=[0.95, 2.10, 0.03], mat="door_dark", pos=[0,0,-0.05])
  box "handle" (size=[0.04, 0.20, 0.03], mat="brass", pos=[0.35,0,0.06], tags="floating")
}

scene {
  slab "lawn" (size=[14.0, 0.04, 12.0], mat="grass")
  slab "foundation" (size=[9.0, 0.20, 8.0], mat="concrete", pos=[0, 0.02, 0])
  slab "driveway" (size=[3.5, 0.04, 5.0], mat="concrete", pos=[4.0, 0.02, -3.5])

  // Front wall — large window band + door
  wall "front_wall" (size=[9.0, 3.00, 0.20], pos=[0, 1.70, -4.0], holes=[
    [-2.50, 0.30, 1.60, 1.40],
    [ 0.00, -0.05, 1.10, 2.10],
    [ 2.50, 0.30, 1.60, 1.40],
  ])
  wall "back_wall" (size=[9.0, 3.00, 0.20], pos=[0, 1.70, 4.0], holes=[
    [-3.00, 0.30, 1.60, 1.40],
    [ 0.00, 0.30, 1.60, 1.40],
    [ 3.00, 0.30, 1.60, 1.40],
  ])
  wall "left_wall" (size=[8.0, 3.00, 0.20], pos=[-4.5, 1.70, 0], rot=[0, 90, 0], holes=[
    [-2.00, 0.50, 1.00, 0.80],
    [ 2.00, 0.50, 1.00, 0.80],
  ])
  wall "right_wall" (size=[8.0, 3.00, 0.20], pos=[4.5, 1.70, 0], rot=[0, 90, 0], holes=[
    [-2.00, 0.50, 1.00, 0.80],
    [ 2.00, 0.50, 1.00, 0.80],
  ])

  slab "floor" (size=[9.0, 0.10, 8.0], mat="concrete", pos=[0, 0.20, 0])
  slab "ceiling" (size=[9.0, 0.10, 8.0], mat="wall_white", pos=[0, 3.15, 0])
  slab "roof" (size=[9.4, 0.10, 8.4], mat="roof_flat", pos=[0, 3.25, 0])
  // Dark accent band (lower 1m of front facade)
  box "accent_band" (size=[9.0, 1.00, 0.02], mat="wall_dark", pos=[0, 0.70, -4.01], tags="floating")

  // Door + windows
  group "door_group" (pos=[0, 1.05, -4.0]) { use "door_modern" () }
  group "wf_l" (pos=[-2.50, 1.70, -4.0]) { use "win_large" () }
  group "wf_r" (pos=[ 2.50, 1.70, -4.0]) { use "win_large" () }
  group "wb_l" (pos=[-3.00, 1.70, 4.0]) { use "win_large" () }
  group "wb_c" (pos=[ 0.00, 1.70, 4.0]) { use "win_large" () }
  group "wb_r" (pos=[ 3.00, 1.70, 4.0]) { use "win_large" () }
  group "wl_b" (pos=[-4.5, 1.90, -2.00], rot=[0,90,0]) { use "win_small" () }
  group "wl_f" (pos=[-4.5, 1.90, 2.00], rot=[0,90,0]) { use "win_small" () }
  group "wr_b" (pos=[ 4.5, 1.90, -2.00], rot=[0,90,0]) { use "win_small" () }
  group "wr_f" (pos=[ 4.5, 1.90, 2.00], rot=[0,90,0]) { use "win_small" () }
}
