meta (name="house_tudor", description="Tudor-style house", tags=["building","house","tudor","tier1"], mogen_version="0.1.12")
material "wall_white" (color=[0.88, 0.85, 0.78], roughness=0.80, uv_mode="tile", uv_scale=3.0)
material "beam_dark" (color=[0.20, 0.15, 0.10], roughness=0.85)
material "roof_tile" (color=[0.35, 0.20, 0.15], roughness=0.80, uv_mode="tile", uv_scale=4.0)
material "trim_white" (color=[0.92, 0.91, 0.86], roughness=0.60)
material "window_glass" (color=[0.45, 0.65, 0.80], transmission=0.50, roughness=0.04)
material "door_wood" (color=[0.30, 0.20, 0.12], roughness=0.65)
material "concrete" (color=[0.55, 0.53, 0.50], roughness=0.90)
material "grass" (color=[0.25, 0.45, 0.18], roughness=0.85, uv_mode="tile", uv_scale=2.5)
material "brass" (color=[0.95, 0.70, 0.25], metallic=0.85, roughness=0.25)
module "win" () { chamfered_box "frame" (size=[1.00, 1.10, 0.06], radius=0.015, mat="trim_white") box "glass" (size=[0.85, 0.95, 0.02], mat="window_glass", pos=[0,0,-0.03]) }
module "dr" () { chamfered_box "frame" (size=[1.05, 2.10, 0.06], radius=0.02, mat="trim_white") chamfered_box "panel" (size=[0.90, 1.95, 0.05], radius=0.015, mat="door_wood", pos=[0,0,-0.08]) sphere "knob" (radius=0.04, mat="brass", pos=[0.30,-0.10,-0.13]) }
scene {
  slab "lawn" (size=[14.0, 0.04, 10.0], mat="grass")
  slab "foundation" (size=[8.4, 0.20, 6.4], mat="concrete", pos=[0, 0.02, 0])
  wall "front_gf" (size=[8.0, 2.55, 0.20], pos=[0, 1.475, -3.0], holes=[[0.0, -0.225, 1.00, 2.10], [-2.50, 0.10, 1.00, 1.10], [2.50, 0.10, 1.00, 1.10]])
  wall "back_gf" (size=[8.0, 2.55, 0.20], pos=[0, 1.475, 3.0], holes=[[-2.50, 0.10, 1.00, 1.10], [2.50, 0.10, 1.00, 1.10]])
  wall "left_gf" (size=[6.0, 2.55, 0.20], pos=[-4.0, 1.475, 0], rot=[0, 90, 0], holes=[[0.0, 0.10, 1.00, 1.10]])
  wall "right_gf" (size=[6.0, 2.55, 0.20], pos=[4.0, 1.475, 0], rot=[0, 90, 0], holes=[[0.0, 0.10, 1.00, 1.10]])
  slab "floor_gf" (size=[8.0, 0.10, 6.0], mat="concrete", pos=[0, 0.20, 0])
  slab "ceiling" (size=[8.0, 0.10, 6.0], mat="wall_white", pos=[0, 2.75, 0])
  prism "roof" (size=[8.8, 1.30, 6.8], pos=[0, 3.40, 0], mat="roof_tile")
  group "dr" (pos=[0, 1.20, -3.0]) { use "dr" () }
  group "wf_l" (pos=[-2.50, 1.575, -3.0]) { use "win" () }
  group "wf_r" (pos=[2.50, 1.575, -3.0]) { use "win" () }
  group "wb_l" (pos=[-2.50, 1.575, 3.0]) { use "win" () }
  group "wb_r" (pos=[2.50, 1.575, 3.0]) { use "win" () }
  group "wl" (pos=[-4.0, 1.575, 0], rot=[0,90,0]) { use "win" () }
  group "wr" (pos=[4.0, 1.575, 0], rot=[0,90,0]) { use "win" () }
}
