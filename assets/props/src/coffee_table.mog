// coffee_table.mog — Tier 1 prop (dynamic furniture)
// Low living room coffee table: rectangular top + lower shelf + 4 legs.
// Target: 250 tris (Low-preset LOD0 standard prop). Actual: ~120 tris.
// Dimensions: 1.20m wide × 0.60m deep × 0.40m tall.

meta (
  name          = "coffee_table",
  description   = "Low coffee table with top + lower shelf + 4 legs",
  tags          = ["prop", "furniture", "table", "coffee", "dynamic", "tier1"],
  mogen_version = "0.1.12"
)

material "wood_oak"  (color=[0.45, 0.28, 0.15], roughness=0.70, uv_mode="tile", uv_scale=2.0)
material "wood_dark" (color=[0.30, 0.18, 0.10], roughness=0.75)

scene {
  // === TABLETOP ===
  rounded_box "top" (size=[1.20, 0.04, 0.60], radius=0.015, mat="wood_oak", pos=[0, 0.38, 0])

  // === LOWER SHELF (for magazines/books) ===
  box "shelf" (size=[1.10, 0.03, 0.50], mat="wood_dark", pos=[0, 0.12, 0])

  // === 4 LEGS (overlap with top + shelf to connect) ===
  box "leg_fl" (size=[0.06, 0.40, 0.06], mat="wood_dark", pos=[-0.55, 0.20,  0.25])
  box "leg_fr" (size=[0.06, 0.40, 0.06], mat="wood_dark", pos=[ 0.55, 0.20,  0.25])
  box "leg_bl" (size=[0.06, 0.40, 0.06], mat="wood_dark", pos=[-0.55, 0.20, -0.25])
  box "leg_br" (size=[0.06, 0.40, 0.06], mat="wood_dark", pos=[ 0.55, 0.20, -0.25])
}
