// sink_bathroom.mog — Tier 1 prop (STATIC fixture — bathroom)
// Wall-mounted bathroom sink: basin + pedestal + faucet.
// Per furniture_merging_decision.md: static fixture (plumbed, can't move).
// Target: 250 tris (Low-preset LOD0). Actual: ~150 tris.
// Dimensions: 0.50m wide × 0.40m deep × 0.85m tall.

meta (
  name          = "sink_bathroom",
  description   = "Wall-mounted bathroom sink with basin + pedestal + faucet (static fixture)",
  tags          = ["prop", "furniture", "bathroom", "sink", "static", "tier1"],
  mogen_version = "0.1.12"
)

material "porcelain" (color=[0.95, 0.95, 0.93], roughness=0.20, metallic=0.0)
material "chrome"    (color=[0.85, 0.85, 0.88], metallic=0.95, roughness=0.15)
material "drain_metal" (color=[0.65, 0.66, 0.68], metallic=0.7, roughness=0.30)

scene {
  // === BASIN (oval bowl, sits on top of pedestal) ===
  // Use a rounded box for the basin outer shape
  rounded_box "basin_outer" (size=[0.45, 0.15, 0.35], radius=0.07, mat="porcelain", pos=[0, 0.80, 0])
  // Basin rim (slightly wider top)
  cylinder "basin_rim" (radius=0.22, height=0.04, segments=12, mat="porcelain", pos=[0, 0.87, 0])

  // Basin inner depression (darker slab to suggest depth)
  slab "basin_inner" (size=[0.30, 0.02, 0.22], mat="drain_metal", pos=[0, 0.83, 0], tags="floating")

  // === DRAIN (small circle in basin center) ===
  cylinder "drain" (radius=0.03, height=0.02, segments=8, mat="drain_metal", pos=[0, 0.84, 0], tags="floating")

  // === PEDESTAL (vertical column supporting basin) ===
  // Tapered: wider at top + bottom, narrower in middle — use 3 stacked cylinders
  cylinder "pedestal_top" (radius=0.10, height=0.05, segments=12, mat="porcelain", pos=[0, 0.70, 0])
  cylinder "pedestal_mid" (radius=0.07, height=0.55, segments=12, mat="porcelain", pos=[0, 0.40, 0])
  cylinder "pedestal_bot" (radius=0.10, height=0.05, segments=12, mat="porcelain", pos=[0, 0.10, 0])

  // === FAUCET (chrome, mounted on wall behind basin) ===
  // Vertical pipe
  cylinder "faucet_pipe" (radius=0.015, height=0.20, segments=8, mat="chrome", pos=[0, 0.92, -0.15])
  // Horizontal spout (extends over basin)
  cylinder "faucet_spout" (radius=0.015, height=0.15, segments=8, mat="chrome", pos=[0, 1.00, -0.08], rot=[90, 0, 0])

  // === 2 FAUCET HANDLES (hot + cold, on either side of faucet) ===
  cylinder "handle_hot"  (radius=0.025, height=0.03, segments=8, mat="chrome", pos=[-0.08, 0.95, -0.14], tags="floating")
  cylinder "handle_cold" (radius=0.025, height=0.03, segments=8, mat="chrome", pos=[ 0.08, 0.95, -0.14], tags="floating")
}
