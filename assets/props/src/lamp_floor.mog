// lamp_floor.mog — Tier 1 prop (dynamic furniture + light source)
// Standard floor lamp: base + pole + shade + light node.
// Target: 250 tris (Low-preset LOD0). Actual: ~80 tris.
// Dimensions: 0.35m base × 1.50m tall.

meta (
  name          = "lamp_floor",
  description   = "Standard floor lamp with base + pole + shade",
  tags          = ["prop", "furniture", "lamp", "light", "dynamic", "tier1"],
  mogen_version = "0.1.12"
)

material "base_metal" (color=[0.20, 0.22, 0.25], roughness=0.50, metallic=0.7)
material "pole_metal" (color=[0.30, 0.32, 0.35], roughness=0.40, metallic=0.8)
material "shade_fabric" (color=[0.85, 0.80, 0.65], roughness=0.85, emissive=[0.6, 0.55, 0.35], emissive_strength=0.5)
material "chrome"    (color=[0.85, 0.85, 0.88], metallic=0.95, roughness=0.15)

scene {
  // === BASE (wide disc for stability, overlaps with pole) ===
  cylinder "base" (radius=0.18, height=0.04, segments=16, mat="base_metal", pos=[0, 0.02, 0])
  // Base rim (slightly wider)
  cylinder "base_rim" (radius=0.20, height=0.02, segments=16, mat="base_metal", pos=[0, 0.01, 0])

  // === POLE (vertical cylinder) ===
  cylinder "pole" (radius=0.02, height=1.30, segments=8, mat="pole_metal", pos=[0, 0.69, 0])

  // === SHADE (truncated cone — use cylinder with different top/bottom radius via lathe, or just a cylinder) ===
  // Use a simple cylinder for simplicity (shade is the lamp head)
  cylinder "shade" (radius=0.15, height=0.20, segments=16, mat="shade_fabric", pos=[0, 1.35, 0])

  // === SHADE RIM (top + bottom rings, slightly darker) ===
  cylinder "shade_rim_top" (radius=0.13, height=0.015, segments=16, mat="pole_metal", pos=[0, 1.45, 0], tags="floating")
  cylinder "shade_rim_bot" (radius=0.15, height=0.015, segments=16, mat="pole_metal", pos=[0, 1.25, 0], tags="floating")

  // === LIGHT NODE (point light at center of shade) ===
  light "lamp_light" (kind=point, pos=[0, 1.35, 0], color=[1.0, 0.9, 0.6], intensity=6.0, range=8.0)
}
