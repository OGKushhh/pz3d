// wall_shelf.mog
meta (name="wall_shelf", description="Wall-mounted floating shelf", tags=["prop","furniture","shelf","wall","static","tier1"], mogen_version="0.1.12")
material "wood_oak" (color=[0.45,0.28,0.15], roughness=0.70, uv_mode="tile", uv_scale=2.0)
material "bracket_metal" (color=[0.30,0.30,0.32], roughness=0.50, metallic=0.7)
scene {
  // Shelf board
  box "shelf" (size=[0.80, 0.04, 0.25], mat="wood_oak", pos=[0, 0, 0])
  // 2 brackets (L-shaped — vertical + horizontal parts)
  box "bracket_l_v" (size=[0.03, 0.15, 0.03], mat="bracket_metal", pos=[-0.35, -0.10, 0], tags="floating")
  box "bracket_l_h" (size=[0.15, 0.03, 0.03], mat="bracket_metal", pos=[-0.28, -0.10, 0], tags="floating")
  box "bracket_r_v" (size=[0.03, 0.15, 0.03], mat="bracket_metal", pos=[ 0.35, -0.10, 0], tags="floating")
  box "bracket_r_h" (size=[0.15, 0.03, 0.03], mat="bracket_metal", pos=[ 0.28, -0.10, 0], tags="floating")
}
