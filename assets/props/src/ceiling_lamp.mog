// ceiling_lamp.mog
meta (name="ceiling_lamp", description="Hanging ceiling lamp with cord, shade, and light", tags=["prop","furniture","lamp","ceiling","light","tier1"], mogen_version="0.1.12")
material "cord_black" (color=[0.10,0.10,0.12], roughness=0.85)
material "shade_brass" (color=[0.75,0.55,0.20], roughness=0.40, metallic=0.6, emissive=[0.4,0.3,0.1], emissive_strength=0.5)
material "bulb_glass" (color=[0.95,0.90,0.70], roughness=0.10, emissive=[0.8,0.7,0.4], emissive_strength=1.0)
material "chrome" (color=[0.85,0.85,0.88], metallic=0.95, roughness=0.15)
scene {
  // Ceiling mount (small disc at top, y=2.40 — ceiling height)
  cylinder "mount" (radius=0.04, height=0.03, segments=8, mat="chrome", pos=[0, 2.385, 0])
  // Cord (thin cylinder hanging down)
  cylinder "cord" (radius=0.008, height=0.40, segments=6, mat="cord_black", pos=[0, 2.17, 0])
  // Shade (cone shape — use cone primitive, inverted)
  cone "shade" (radius=0.12, height=0.15, sides=12, mat="shade_brass", pos=[0, 1.90, 0], rot=[180, 0, 0])
  // Bulb (small sphere inside shade)
  sphere "bulb" (radius=0.04, mat="bulb_glass", pos=[0, 1.85, 0], tags="floating")
  // Light node
  light "lamp_light" (kind=point, pos=[0, 1.80, 0], color=[1.0, 0.85, 0.5], intensity=5.0, range=6.0)
}
