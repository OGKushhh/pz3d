// kitchen_empty_counter.mog — Tier 1 prop (modular kitchen piece #3)
// Plain kitchen counter section with cabinets below. No sink, no stove.
// Used to fill space between sink_unit and stove_unit, or as standalone counter.
// Target: 250 tris (standard prop). Actual: ~80 tris.
// Dimensions: 1.0m wide × 0.60m deep × 0.90m tall.

meta (
  name          = "kitchen_empty_counter",
  description   = "Plain kitchen counter section with cabinets (modular, no sink/stove)",
  tags          = ["prop", "furniture", "kitchen", "modular", "static", "tier1"],
  mogen_version = "0.1.12"
)

material "counter_top"  (color=[0.20, 0.20, 0.22], roughness=0.30, metallic=0.2)
material "cabinet_wood" (color=[0.55, 0.40, 0.25], roughness=0.70, uv_mode="tile", uv_scale=2.0)
material "handle_metal" (color=[0.45, 0.45, 0.48], metallic=0.7, roughness=0.30)

scene {
  // === CARCASS ===
  solid "carcass" (mat="cabinet_wood", cleanup="coplanar") {
    box "back"   (size=[1.00, 0.85, 0.05], pos=[0, 0.425, -0.275])
    box "left"   (size=[0.05, 0.85, 0.60], pos=[-0.475, 0.425, 0])
    box "right"  (size=[0.05, 0.85, 0.60], pos=[ 0.475, 0.425, 0])
    box "bottom" (size=[1.00, 0.05, 0.60], pos=[0, 0.025, 0])
    // Internal divider (2 cabinets)
    box "divider" (size=[0.04, 0.78, 0.55], pos=[0, 0.44, 0])
  }

  // === COUNTERTOP (overlaps with carcass) ===
  slab "counter_top" (size=[1.02, 0.06, 0.62], mat="counter_top", pos=[0, 0.83, 0])

  // === 2 CABINET DOORS (front face — decorative panels, floating) ===
  box "cabinet_door_l" (size=[0.45, 0.70, 0.04], mat="cabinet_wood", pos=[-0.25, 0.45, 0.30], tags="floating")
  box "cabinet_door_r" (size=[0.45, 0.70, 0.04], mat="cabinet_wood", pos=[ 0.25, 0.45, 0.30], tags="floating")
  // Door handles
  box "handle_l" (size=[0.10, 0.02, 0.04], mat="handle_metal", pos=[-0.10, 0.45, 0.32], tags="floating")
  box "handle_r" (size=[0.10, 0.02, 0.04], mat="handle_metal", pos=[ 0.10, 0.45, 0.32], tags="floating")
}
