// kitchen_stove_unit.mog — Tier 1 prop (modular kitchen piece #2)
// Kitchen stove + counter section. 4 burners on top, oven door below.
// Designed to place side-by-side with kitchen_sink_unit and kitchen_empty_counter.
// Target: 250 tris (standard prop). Actual: ~200 tris.
// Dimensions: 1.0m wide × 0.60m deep × 0.90m tall.

meta (
  name          = "kitchen_stove_unit",
  description   = "Kitchen stove + counter section with 4 burners and oven (modular)",
  tags          = ["prop", "furniture", "kitchen", "stove", "modular", "static", "tier1"],
  mogen_version = "0.1.12"
)

material "counter_top"  (color=[0.20, 0.20, 0.22], roughness=0.30, metallic=0.2)
material "cabinet_wood" (color=[0.55, 0.40, 0.25], roughness=0.70, uv_mode="tile", uv_scale=2.0)
material "stove_metal"  (color=[0.18, 0.18, 0.20], roughness=0.40, metallic=0.6)
material "burner_black" (color=[0.08, 0.08, 0.08], roughness=0.85)
material "oven_glass"   (color=[0.15, 0.15, 0.18], roughness=0.20, metallic=0.5)
material "handle_metal" (color=[0.45, 0.45, 0.48], metallic=0.7, roughness=0.30)

scene {
  // === CARCASS ===
  solid "carcass" (mat="cabinet_wood", cleanup="coplanar") {
    box "back"   (size=[1.00, 0.85, 0.05], pos=[0, 0.425, -0.275])
    box "left"   (size=[0.05, 0.85, 0.60], pos=[-0.475, 0.425, 0])
    box "right"  (size=[0.05, 0.85, 0.60], pos=[ 0.475, 0.425, 0])
    box "bottom" (size=[1.00, 0.05, 0.60], pos=[0, 0.025, 0])
  }

  // === COUNTERTOP / STOVE TOP (metal, overlaps with carcass) ===
  slab "stove_top" (size=[1.02, 0.06, 0.62], mat="stove_metal", pos=[0, 0.83, 0])

  // === 4 BURNERS ===
  cylinder "burner_fl" (radius=0.08, height=0.01, segments=12, mat="burner_black", pos=[-0.20, 0.89, -0.10])
  cylinder "burner_fr" (radius=0.08, height=0.01, segments=12, mat="burner_black", pos=[ 0.20, 0.89, -0.10])
  cylinder "burner_bl" (radius=0.08, height=0.01, segments=12, mat="burner_black", pos=[-0.20, 0.89,  0.10])
  cylinder "burner_br" (radius=0.08, height=0.01, segments=12, mat="burner_black", pos=[ 0.20, 0.89,  0.10])

  // === OVEN DOOR (front, with glass window — decorative panel, floating) ===
  box "oven_door" (size=[0.85, 0.60, 0.04], mat="stove_metal", pos=[0, 0.35, 0.30], tags="floating")
  box "oven_window" (size=[0.55, 0.35, 0.02], mat="oven_glass", pos=[0, 0.35, 0.32], tags="floating")
  // Oven handle (horizontal bar at top of door)
  box "oven_handle" (size=[0.50, 0.03, 0.04], mat="handle_metal", pos=[0, 0.65, 0.32], tags="floating")

  // === CONTROL KNOBS (4 small discs above oven door, on back panel) ===
  cylinder "knob_1" (radius=0.025, height=0.02, segments=8, mat="handle_metal", pos=[-0.30, 0.75, 0.30], tags="floating")
  cylinder "knob_2" (radius=0.025, height=0.02, segments=8, mat="handle_metal", pos=[-0.10, 0.75, 0.30], tags="floating")
  cylinder "knob_3" (radius=0.025, height=0.02, segments=8, mat="handle_metal", pos=[ 0.10, 0.75, 0.30], tags="floating")
  cylinder "knob_4" (radius=0.025, height=0.02, segments=8, mat="handle_metal", pos=[ 0.30, 0.75, 0.30], tags="floating")
}
