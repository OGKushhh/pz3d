// npc_soldier.mog — military soldier with assault rifle
meta (name="npc_soldier", description="Military soldier in tactical gear holding assault rifle, combat-ready pose", tags=["character","npc","soldier","military","neutral","tier1"], mogen_version="0.1.12")
material "skin" (color=[0.80,0.65,0.50], roughness=0.7)
material "helmet_olive" (color=[0.30,0.32,0.20], roughness=0.60, metallic=0.3)
material "uniform_olive" (color=[0.32,0.35,0.22], roughness=0.80, uv_mode="tile", uv_scale=3.0)
material "vest_olive" (color=[0.25,0.28,0.18], roughness=0.70, metallic=0.3)
material "boots_black" (color=[0.05,0.05,0.06], roughness=0.6)
material "rifle_black" (color=[0.10,0.10,0.12], roughness=0.40, metallic=0.85)
material "metal_grey" (color=[0.30,0.30,0.32], roughness=0.50, metallic=0.85)
material "eyes_white" (color=[0.95,0.95,0.95], roughness=0.30, emissive=[0.10,0.10,0.10], emissive_strength=0.3)
material "strap_black" (color=[0.10,0.10,0.12], roughness=0.80)
scene {
  // Body — combat stance, slightly crouched
  box "pelvis_mesh" (size=[0.34, 0.20, 0.22], mat="uniform_olive", pos=[0, 0.90, 0], tags="floating")
  box "torso_mesh" (size=[0.48, 0.55, 0.30], mat="uniform_olive", pos=[0, 1.25, 0], tags="floating")
  // Tactical vest (over torso)
  box "vest_mesh" (size=[0.50, 0.45, 0.32], mat="vest_olive", pos=[0, 1.30, 0], tags="floating")
  // Vest pouches (front)
  box "pouch_l" (size=[0.12, 0.15, 0.05], mat="vest_olive", pos=[-0.13, 1.20, 0.17], tags="floating")
  box "pouch_r" (size=[0.12, 0.15, 0.05], mat="vest_olive", pos=[0.13, 1.20, 0.17], tags="floating")
  // Head + helmet
  box "head_mesh" (size=[0.22, 0.26, 0.22], mat="skin", pos=[0, 1.60, 0], tags="floating")
  // Helmet (covers top half of head)
  box "helmet_top" (size=[0.26, 0.14, 0.28], mat="helmet_olive", pos=[0, 1.72, 0], tags="floating")
  box "helmet_rim" (size=[0.28, 0.04, 0.30], mat="helmet_olive", pos=[0, 1.66, 0], tags="floating")
  // Helmet strap
  box "strap_chin" (size=[0.04, 0.10, 0.04], mat="strap_black", pos=[0, 1.55, 0.13], tags="floating")
  // Eyes
  sphere "eye_l" (radius=0.025, mat="eyes_white", pos=[-0.05, 1.62, 0.115], tags="floating")
  sphere "eye_r" (radius=0.025, mat="eyes_white", pos=[0.05, 1.62, 0.115], tags="floating")
  // Arms — both forward, holding rifle
  box "upper_arm_l" (size=[0.14, 0.25, 0.14], mat="uniform_olive", pos=[-0.28, 1.30, 0.15], rot=[60,0,0], tags="floating")
  box "forearm_l" (size=[0.12, 0.25, 0.12], mat="uniform_olive", pos=[-0.28, 1.10, 0.40], rot=[60,0,0], tags="floating")
  box "hand_l" (size=[0.10, 0.10, 0.06], mat="skin", pos=[-0.28, 1.00, 0.60], tags="floating")
  box "upper_arm_r" (size=[0.14, 0.25, 0.14], mat="uniform_olive", pos=[0.28, 1.30, 0.15], rot=[60,0,0], tags="floating")
  box "forearm_r" (size=[0.12, 0.25, 0.12], mat="uniform_olive", pos=[0.28, 1.10, 0.40], rot=[60,0,0], tags="floating")
  box "hand_r" (size=[0.10, 0.10, 0.06], mat="skin", pos=[0.28, 1.00, 0.60], tags="floating")
  // Rifle (held in both hands, pointing forward)
  box "rifle_body" (size=[0.08, 0.12, 0.80], mat="rifle_black", pos=[0, 1.05, 0.50], tags="floating")
  box "rifle_barrel" (size=[0.04, 0.04, 0.40], mat="rifle_black", pos=[0, 1.10, 0.95], tags="floating")
  box "rifle_magazine" (size=[0.06, 0.18, 0.10], mat="rifle_black", pos=[0, 0.92, 0.45], tags="floating")
  box "rifle_stock" (size=[0.08, 0.15, 0.20], mat="rifle_black", pos=[0, 1.05, 0.20], tags="floating")
  box "rifle_scope" (size=[0.05, 0.10, 0.20], mat="metal_grey", pos=[0, 1.18, 0.55], tags="floating")
  // Legs — slightly bent (combat stance)
  box "thigh_l" (size=[0.18, 0.42, 0.16], mat="uniform_olive", pos=[-0.13, 0.65, 0.05], rot=[10,0,0], tags="floating")
  box "shin_l" (size=[0.16, 0.40, 0.14], mat="uniform_olive", pos=[-0.13, 0.25, 0.12], tags="floating")
  box "foot_l" (size=[0.18, 0.10, 0.32], mat="boots_black", pos=[-0.13, 0.00, 0.22], tags="floating")
  box "thigh_r" (size=[0.18, 0.42, 0.16], mat="uniform_olive", pos=[0.13, 0.65, 0.05], rot=[10,0,0], tags="floating")
  box "shin_r" (size=[0.16, 0.40, 0.14], mat="uniform_olive", pos=[0.13, 0.25, 0.12], tags="floating")
  box "foot_r" (size=[0.18, 0.10, 0.32], mat="boots_black", pos=[0.13, 0.00, 0.22], tags="floating")
  // Knee pads
  box "knee_pad_l" (size=[0.18, 0.10, 0.04], mat="vest_olive", pos=[-0.13, 0.30, 0.16], tags="floating")
  box "knee_pad_r" (size=[0.18, 0.10, 0.04], mat="vest_olive", pos=[0.13, 0.30, 0.16], tags="floating")
  // Backpack (small assault pack)
  box "pack_body" (size=[0.30, 0.40, 0.18], mat="vest_olive", pos=[0, 1.25, -0.18], tags="floating")
  // Antenna on pack
  cylinder "antenna" (radius=0.01, height=0.50, mat="metal_grey", pos=[0.15, 1.70, -0.18], tags="floating")
}
