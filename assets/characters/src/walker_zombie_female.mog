// walker_zombie_female.mog — female walker zombie with long hair and torn dress
meta (name="walker_zombie_female", description="Female walker zombie with long matted hair, torn floral dress, hunched posture", tags=["character","zombie","walker","female","enemy","tier1"], mogen_version="0.1.12")
material "skin_pale" (color=[0.60,0.55,0.50], roughness=0.85)
material "hair_long" (color=[0.18,0.14,0.10], roughness=0.85)
material "dress_torn" (color=[0.50,0.40,0.45], roughness=0.85, uv_mode="tile", uv_scale=2.0)
material "boots_dark" (color=[0.10,0.08,0.06], roughness=0.6)
material "eyes_red" (color=[0.85,0.10,0.05], roughness=0.30, emissive=[0.7,0.10,0.05], emissive_strength=0.6)
material "blood_dark" (color=[0.30,0.05,0.05], roughness=0.95)
material "teeth_yellow" (color=[0.65,0.55,0.30], roughness=0.70)
scene {
  // Body — slimmer female proportions
  box "pelvis_mesh" (size=[0.30, 0.18, 0.22], mat="dress_torn", pos=[0, 0.90, 0.04], tags="floating")
  box "torso_mesh" (size=[0.40, 0.50, 0.26], mat="dress_torn", pos=[0, 1.18, 0.08], tags="floating")
  // Dress extends below hips
  cone "dress_skirt" (radius=0.28, height=0.50, mat="dress_torn", pos=[0, 0.65, 0.04], tags="floating")
  box "head_mesh" (size=[0.20, 0.24, 0.20], mat="skin_pale", pos=[0, 1.50, 0.02], tags="floating")
  // Long hair — covering sides and back of head
  box "hair_top" (size=[0.22, 0.08, 0.22], mat="hair_long", pos=[0, 1.60, 0.02], tags="floating")
  box "hair_back" (size=[0.22, 0.30, 0.06], mat="hair_long", pos=[0, 1.45, -0.10], tags="floating")
  box "hair_l" (size=[0.06, 0.25, 0.18], mat="hair_long", pos=[-0.11, 1.40, 0.02], tags="floating")
  box "hair_r" (size=[0.06, 0.25, 0.18], mat="hair_long", pos=[0.11, 1.40, 0.02], tags="floating")
  // Eyes — glowing red
  sphere "eye_l" (radius=0.022, mat="eyes_red", pos=[-0.045, 1.51, 0.12], tags="floating")
  sphere "eye_r" (radius=0.022, mat="eyes_red", pos=[0.045, 1.51, 0.12], tags="floating")
  // Mouth
  box "mouth_open" (size=[0.10, 0.05, 0.04], mat="blood_dark", pos=[0, 1.42, 0.12], tags="floating")
  box "teeth_top" (size=[0.08, 0.02, 0.02], mat="teeth_yellow", pos=[0, 1.44, 0.11], tags="floating")
  // Arms — reaching forward
  box "upper_arm_l" (size=[0.12, 0.30, 0.12], mat="dress_torn", pos=[-0.28, 1.18, 0.20], rot=[70,0,0], tags="floating")
  box "forearm_l" (size=[0.10, 0.30, 0.10], mat="skin_pale", pos=[-0.28, 1.00, 0.45], rot=[70,0,0], tags="floating")
  box "hand_l" (size=[0.08, 0.10, 0.06], mat="skin_pale", pos=[-0.28, 0.88, 0.65], tags="floating")
  box "upper_arm_r" (size=[0.12, 0.30, 0.12], mat="dress_torn", pos=[0.28, 1.18, 0.20], rot=[70,0,0], tags="floating")
  box "forearm_r" (size=[0.10, 0.30, 0.10], mat="skin_pale", pos=[0.28, 1.00, 0.45], rot=[70,0,0], tags="floating")
  box "hand_r" (size=[0.08, 0.10, 0.06], mat="skin_pale", pos=[0.28, 0.88, 0.65], tags="floating")
  // Legs
  box "thigh_l" (size=[0.14, 0.45, 0.14], mat="skin_pale", pos=[-0.12, 0.65, 0.04], tags="floating")
  box "shin_l" (size=[0.12, 0.40, 0.12], mat="skin_pale", pos=[-0.12, 0.20, 0.04], tags="floating")
  box "foot_l" (size=[0.14, 0.10, 0.28], mat="boots_dark", pos=[-0.12, 0.00, 0.14], tags="floating")
  box "thigh_r" (size=[0.14, 0.45, 0.14], mat="skin_pale", pos=[0.12, 0.65, 0.04], tags="floating")
  box "shin_r" (size=[0.12, 0.40, 0.12], mat="skin_pale", pos=[0.12, 0.20, 0.04], tags="floating")
  box "foot_r" (size=[0.14, 0.10, 0.28], mat="boots_dark", pos=[0.12, 0.00, 0.14], tags="floating")
  // Blood stains
  box "blood_shoulder" (size=[0.10, 0.06, 0.02], mat="blood_dark", pos=[0.22, 1.30, 0.18], tags="floating")
  box "blood_mouth_chin" (size=[0.06, 0.04, 0.02], mat="blood_dark", pos=[0, 1.38, 0.13], tags="floating")
}
