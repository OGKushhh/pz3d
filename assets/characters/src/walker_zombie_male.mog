// walker_zombie_male.mog — hunched male walker zombie
meta (name="walker_zombie_male", description="Hunched male walker zombie with torn shirt and grey-green skin, arms outstretched", tags=["character","zombie","walker","male","enemy","tier1"], mogen_version="0.1.12")
material "skin_zombie" (color=[0.50,0.55,0.42], roughness=0.85)
material "hair_dark" (color=[0.15,0.12,0.10], roughness=0.80)
material "shirt_torn" (color=[0.40,0.35,0.30], roughness=0.85, uv_mode="tile", uv_scale=2.0)
material "pants_dark" (color=[0.18,0.16,0.14], roughness=0.85)
material "boots_dark" (color=[0.10,0.08,0.06], roughness=0.6)
material "eyes_red" (color=[0.85,0.10,0.05], roughness=0.30, emissive=[0.7,0.10,0.05], emissive_strength=0.6)
material "blood_dark" (color=[0.30,0.05,0.05], roughness=0.95)
material "teeth_yellow" (color=[0.65,0.55,0.30], roughness=0.70)
scene {
  // Hunched body
  box "pelvis_mesh" (size=[0.32, 0.20, 0.22], mat="pants_dark", pos=[0, 0.90, 0.05], tags="floating")
  box "torso_mesh" (size=[0.45, 0.55, 0.28], mat="shirt_torn", pos=[0, 1.20, 0.10], tags="floating")
  box "head_mesh" (size=[0.22, 0.26, 0.22], mat="skin_zombie", pos=[0, 1.55, 0.03], tags="floating")
  // Hair — patchy, just top of head
  box "hair_mesh" (size=[0.24, 0.06, 0.24], mat="hair_dark", pos=[0, 1.66, 0.03], tags="floating")
  // Eyes — glowing red
  sphere "eye_l" (radius=0.025, mat="eyes_red", pos=[-0.05, 1.56, 0.14], tags="floating")
  sphere "eye_r" (radius=0.025, mat="eyes_red", pos=[0.05, 1.56, 0.14], tags="floating")
  // Mouth — open, showing teeth
  box "mouth_open" (size=[0.12, 0.06, 0.04], mat="blood_dark", pos=[0, 1.46, 0.14], tags="floating")
  box "teeth_top" (size=[0.10, 0.02, 0.02], mat="teeth_yellow", pos=[0, 1.48, 0.13], tags="floating")
  box "teeth_bot" (size=[0.10, 0.02, 0.02], mat="teeth_yellow", pos=[0, 1.44, 0.13], tags="floating")
  // Arms — outstretched forward (zombie pose)
  box "upper_arm_l" (size=[0.14, 0.30, 0.14], mat="shirt_torn", pos=[-0.30, 1.20, 0.20], rot=[60,0,0], tags="floating")
  box "forearm_l" (size=[0.12, 0.30, 0.12], mat="skin_zombie", pos=[-0.30, 1.00, 0.45], rot=[60,0,0], tags="floating")
  box "hand_l" (size=[0.10, 0.12, 0.06], mat="skin_zombie", pos=[-0.30, 0.85, 0.65], tags="floating")
  box "upper_arm_r" (size=[0.14, 0.30, 0.14], mat="shirt_torn", pos=[0.30, 1.20, 0.20], rot=[60,0,0], tags="floating")
  box "forearm_r" (size=[0.12, 0.30, 0.12], mat="skin_zombie", pos=[0.30, 1.00, 0.45], rot=[60,0,0], tags="floating")
  box "hand_r" (size=[0.10, 0.12, 0.06], mat="skin_zombie", pos=[0.30, 0.85, 0.65], tags="floating")
  // Tiny markers for unused bones (shoulder_l, shoulder_r, forearm_l, forearm_r) — required by skin binding
  // Legs — slight stagger
  box "thigh_l" (size=[0.16, 0.45, 0.16], mat="pants_dark", pos=[-0.13, 0.65, 0.05], rot=[5,0,0], tags="floating")
  box "shin_l" (size=[0.14, 0.40, 0.14], mat="pants_dark", pos=[-0.13, 0.20, 0.10], tags="floating")
  box "foot_l" (size=[0.16, 0.10, 0.30], mat="boots_dark", pos=[-0.13, 0.00, 0.18], tags="floating")
  box "thigh_r" (size=[0.16, 0.45, 0.16], mat="pants_dark", pos=[0.13, 0.65, 0], rot=[-3,0,0], tags="floating")
  box "shin_r" (size=[0.14, 0.40, 0.14], mat="pants_dark", pos=[0.13, 0.20, 0.05], tags="floating")
  box "foot_r" (size=[0.16, 0.10, 0.30], mat="boots_dark", pos=[0.13, 0.00, 0.18], tags="floating")
  // Blood stains (clothing)
  box "blood_chest" (size=[0.15, 0.10, 0.02], mat="blood_dark", pos=[-0.05, 1.20, 0.24], tags="floating")
  box "blood_arm" (size=[0.10, 0.05, 0.02], mat="blood_dark", pos=[0.30, 1.30, 0.18], tags="floating")
}
