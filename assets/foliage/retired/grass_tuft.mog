// grass_tuft.mog — Tier 1 foliage #4
// Small grass cluster: 6 blade quads splayed from a base.
// Designed for MultiMeshInstance3D scatter (thousands per chunk).
// Target: 80 tris. Actual: ~60 tris.
// Dimensions: ~0.30m wide × 0.30m deep × 0.25m tall.
// NOTE: `quad` primitive uses `w` and `h` attributes (not `size=`).

meta (
  name          = "grass_tuft",
  description   = "Small grass tuft — 6 blade quads splayed from base",
  tags          = ["foliage", "grass", "ground_cover", "multimesh", "tier1"],
  mogen_version = "0.1.12"
)

material "grass_green" (color=[0.25, 0.45, 0.18], roughness=0.85, alpha_mode="mask", alpha_cutoff=0.5, double_sided=1)
material "grass_dark"  (color=[0.15, 0.32, 0.12], roughness=0.85, alpha_mode="mask", alpha_cutoff=0.5, double_sided=1)

scene {
  // 6 thin blade quads. `quad` is XY-aligned (w=width, h=height).
  quad "blade_1" (w=0.04, h=0.25, mat="grass_green", pos=[0, 0.125, 0.10], tags="floating")
  quad "blade_2" (w=0.04, h=0.22, mat="grass_dark", pos=[0.09, 0.110, -0.05], rot=[0, 60, 0], tags="floating")
  quad "blade_3" (w=0.04, h=0.20, mat="grass_green", pos=[0, 0.100, -0.10], rot=[0, 180, 0], tags="floating")
  quad "blade_4" (w=0.04, h=0.23, mat="grass_dark", pos=[-0.09, 0.115, -0.05], rot=[0, 240, 0], tags="floating")
  quad "blade_5" (w=0.04, h=0.21, mat="grass_green", pos=[-0.08, 0.105, 0.07], rot=[0, 300, 0], tags="floating")
  quad "blade_6" (w=0.04, h=0.26, mat="grass_dark", pos=[0.08, 0.130, 0.08], rot=[0, 30, 0], tags="floating")

  // Tiny ground clump
  cylinder "base" (radius=0.06, height=0.01, segments=8, mat="grass_dark", pos=[0, 0.005, 0], tags="floating")
}
