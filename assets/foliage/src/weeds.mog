// weeds.mog
meta (name="weeds", description="Small weed cluster, ground cover for MultiMesh scatter", tags=["foliage","weeds","ground_cover","multimesh","tier1"], mogen_version="0.1.12")
material "weed_green" (color=[0.25,0.42,0.18], roughness=0.85, alpha_mode="mask", alpha_cutoff=0.5, double_sided=1)
material "weed_dark" (color=[0.15,0.30,0.12], roughness=0.85, alpha_mode="mask", alpha_cutoff=0.5, double_sided=1)
scene {
  // 5 weed blades — thin quads splayed from base
  quad "weed_1" (w=0.02, h=0.15, mat="weed_green", pos=[0, 0.075, 0.05], tags="floating")
  quad "weed_2" (w=0.02, h=0.12, mat="weed_dark", pos=[0.06, 0.06, -0.03], rot=[0, 60, 0], tags="floating")
  quad "weed_3" (w=0.02, h=0.13, mat="weed_green", pos=[-0.05, 0.065, -0.04], rot=[0, -50, 0], tags="floating")
  quad "weed_4" (w=0.02, h=0.10, mat="weed_dark", pos=[0.08, 0.05, 0.08], rot=[0, 30, 0], tags="floating")
  quad "weed_5" (w=0.02, h=0.14, mat="weed_green", pos=[-0.07, 0.07, 0.06], rot=[0, -70, 0], tags="floating")
}
