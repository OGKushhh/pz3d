// palm_tree.mog
meta (name="palm_tree", description="Stylized palm tree with fronds", tags=["foliage","tree","palm","tropical","beach","tier1"], mogen_version="0.1.12")
material "trunk_tan" (color=[0.60,0.45,0.30], roughness=0.85, uv_mode="tile", uv_scale=2.0)
material "frond_green" (color=[0.25,0.45,0.18], roughness=0.85, alpha_mode="mask", alpha_cutoff=0.5, double_sided=1)
material "frond_dark" (color=[0.15,0.32,0.12], roughness=0.85, alpha_mode="mask", alpha_cutoff=0.5, double_sided=1)
material "coconut_brown" (color=[0.35,0.22,0.12], roughness=0.85)
scene {
  // Trunk (slightly bent cylinder)
  cylinder "trunk" (radius=0.15, height=4.00, segments=10, mat="trunk_tan", pos=[0, 2.00, 0], bend_x=3)
  // Trunk ring details (3 darker bands)
  cylinder "ring_1" (radius=0.155, height=0.02, segments=10, mat="frond_dark", pos=[0, 1.00, 0], tags="floating")
  cylinder "ring_2" (radius=0.155, height=0.02, segments=10, mat="frond_dark", pos=[0, 2.00, 0], tags="floating")
  cylinder "ring_3" (radius=0.155, height=0.02, segments=10, mat="frond_dark", pos=[0, 3.00, 0], tags="floating")
  // 7 fronds (palm leaves) radiating from top — each is a flat quad angled outward + slightly down
  quad "frond_1" (w=0.20, h=1.50, mat="frond_green", pos=[0.60, 4.10, 0], rot=[0, 0, 60], tags="floating")
  quad "frond_2" (w=0.20, h=1.50, mat="frond_green", pos=[-0.60, 4.10, 0], rot=[0, 0, -60], tags="floating")
  quad "frond_3" (w=0.20, h=1.40, mat="frond_dark", pos=[0, 4.10, 0.60], rot=[60, 0, 0], tags="floating")
  quad "frond_4" (w=0.20, h=1.40, mat="frond_dark", pos=[0, 4.10, -0.60], rot=[-60, 0, 0], tags="floating")
  quad "frond_5" (w=0.18, h=1.30, mat="frond_green", pos=[0.45, 4.10, 0.45], rot=[45, 45, 45], tags="floating")
  quad "frond_6" (w=0.18, h=1.30, mat="frond_green", pos=[-0.45, 4.10, -0.45], rot=[-45, -45, -45], tags="floating")
  quad "frond_7" (w=0.18, h=1.30, mat="frond_dark", pos=[0.45, 4.10, -0.45], rot=[-45, 45, -45], tags="floating")
  // 3 coconuts (small brown spheres clustered at top of trunk)
  sphere "coconut_1" (radius=0.06, mat="coconut_brown", pos=[0.05, 4.05, 0.05], tags="floating")
  sphere "coconut_2" (radius=0.05, mat="coconut_brown", pos=[-0.08, 4.00, 0.03], tags="floating")
  sphere "coconut_3" (radius=0.05, mat="coconut_brown", pos=[0.03, 4.08, -0.07], tags="floating")
}
