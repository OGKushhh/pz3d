meta (name="ivy_wall", description="Ivy-covered wall patch for building decoration", tags=["foliage","ivy","wall","decoration","tier1"], mogen_version="0.1.12")
material "leaves_green" (color=[0.20, 0.40, 0.18], roughness=0.85, alpha_mode="mask", alpha_cutoff=0.5, double_sided=1, uv_mode="tile", uv_scale=1.5)
material "leaves_dark" (color=[0.12, 0.30, 0.10], roughness=0.85, alpha_mode="mask", alpha_cutoff=0.5, double_sided=1, uv_mode="tile", uv_scale=1.5)
scene {
  quad "ivy_1" (w=2.00, h=3.00, mat="leaves_green", pos=[0, 1.50, 0.02], tags="floating")
  quad "ivy_2" (w=1.50, h=2.00, mat="leaves_dark", pos=[-0.30, 1.00, 0.03], rot=[0, 0, 5], tags="floating")
  quad "ivy_3" (w=1.00, h=1.50, mat="leaves_green", pos=[0.50, 2.20, 0.03], rot=[0, 0, -5], tags="floating")
}
