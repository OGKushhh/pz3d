// cattail.mog
meta (name="cattail", description="Wetland cattail plant", tags=["foliage","cattail","wetland","tier1"], mogen_version="0.1.12")
material "stem_green" (color=[0.30,0.45,0.18], roughness=0.85)
material "cattail_brown" (color=[0.45,0.30,0.12], roughness=0.85)
material "leaf_green" (color=[0.25,0.42,0.15], roughness=0.85, alpha_mode="mask", alpha_cutoff=0.5, double_sided=1)
scene {
  // 3 cattail stems (vertical cylinders)
  cylinder "stem_1" (radius=0.008, height=0.70, segments=6, mat="stem_green", pos=[-0.05, 0.35, 0.02], tags="floating")
  cylinder "stem_2" (radius=0.008, height=0.75, segments=6, mat="stem_green", pos=[0.04, 0.375, -0.03], tags="floating")
  cylinder "stem_3" (radius=0.008, height=0.65, segments=6, mat="stem_green", pos=[0, 0.325, 0.06], tags="floating")
  // 3 cattail heads (brown cylindrical spikes at top of stems)
  cylinder "head_1" (radius=0.02, height=0.15, segments=8, mat="cattail_brown", pos=[-0.05, 0.78, 0.02], tags="floating")
  cylinder "head_2" (radius=0.02, height=0.15, segments=8, mat="cattail_brown", pos=[0.04, 0.83, -0.03], tags="floating")
  cylinder "head_3" (radius=0.02, height=0.15, segments=8, mat="cattail_brown", pos=[0, 0.73, 0.06], tags="floating")
  // 4 leaves (long flat blades arching outward)
  quad "leaf_1" (w=0.03, h=0.60, mat="leaf_green", pos=[0.12, 0.30, 0.05], rot=[0, 0, 20], tags="floating")
  quad "leaf_2" (w=0.03, h=0.55, mat="leaf_green", pos=[-0.13, 0.28, -0.02], rot=[0, 0, -20], tags="floating")
  quad "leaf_3" (w=0.03, h=0.50, mat="leaf_green", pos=[0.08, 0.25, -0.10], rot=[0, 60, 15], tags="floating")
  quad "leaf_4" (w=0.03, h=0.45, mat="leaf_green", pos=[-0.10, 0.22, 0.08], rot=[0, -60, -15], tags="floating")
}
