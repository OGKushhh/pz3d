// fern.mog
meta (name="fern", description="Stylized fern plant", tags=["foliage","fern","forest","tier1"], mogen_version="0.1.12")
material "fern_green" (color=[0.20,0.40,0.18], roughness=0.85, alpha_mode="mask", alpha_cutoff=0.5, double_sided=1)
material "fern_dark" (color=[0.12,0.30,0.12], roughness=0.85, alpha_mode="mask", alpha_cutoff=0.5, double_sided=1)
scene {
  // Central stem
  cylinder "stem" (radius=0.01, height=0.40, segments=6, mat="fern_dark", pos=[0, 0.20, 0])
  // 6 fronds (leaf blades) radiating from stem — each is a quad angled outward + upward
  quad "frond_1" (w=0.04, h=0.30, mat="fern_green", pos=[0.10, 0.25, 0.05], rot=[0, 0, 45], tags="floating")
  quad "frond_2" (w=0.04, h=0.28, mat="fern_dark", pos=[-0.10, 0.25, 0.05], rot=[0, 0, -45], tags="floating")
  quad "frond_3" (w=0.04, h=0.25, mat="fern_green", pos=[0.08, 0.30, -0.08], rot=[0, 90, 45], tags="floating")
  quad "frond_4" (w=0.04, h=0.22, mat="fern_dark", pos=[-0.08, 0.30, -0.08], rot=[0, 90, -45], tags="floating")
  quad "frond_5" (w=0.04, h=0.20, mat="fern_green", pos=[0, 0.35, 0.10], rot=[45, 0, 0], tags="floating")
  quad "frond_6" (w=0.04, h=0.18, mat="fern_dark", pos=[0, 0.35, -0.10], rot=[-45, 0, 0], tags="floating")
}
