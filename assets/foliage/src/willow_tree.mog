material "leaves_light" (color=[0.30, 0.50, 0.22], roughness=0.85, uv_mode="tile", uv_scale=1.5)
material "leaves_dark" (color=[0.20, 0.38, 0.15], roughness=0.85, uv_mode="tile", uv_scale=1.5)
scene {
