  icosphere "canopy_f" (radius=0.70, subdivisions=2, mat="leaves_light", pos=[0.10, 2.50, 0.70], noise=0.12, seed=23)
  icosphere "canopy_b" (radius=0.70, subdivisions=2, mat="leaves_dark", pos=[-0.10, 2.50, -0.70], noise=0.10, seed=29)
  cylinder "branch_1" (radius=0.04, height=1.00, segments=6, mat="bark_brown", pos=[0.40, 2.30, 0.20], rot=[40, 0, 30])
  cylinder "branch_2" (radius=0.04, height=0.90, segments=6, mat="bark_brown", pos=[-0.35, 2.40, -0.20], rot=[-35, 0, -25])
}
