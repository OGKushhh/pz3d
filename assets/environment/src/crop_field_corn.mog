  sphere "leaf_4c_2" (radius=0.30, mat="corn_dark", pos=[0, 1.40, 1.0], tags="floating")
  cylinder "stalk_4d" (radius=0.05, height=2.30, mat="stalk_tan", pos=[2.0, 1.25, 1.0], tags="floating")
