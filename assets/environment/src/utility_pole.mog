// utility_pole.mog — Telephone/utility pole (shorter than power_pole)
meta (name="utility_pole", description="Telephone utility pole with crossbar", tags=["environment","utility_pole","telephone","suburban","tier1"], mogen_version="0.1.12")
material "pole_wood" (color=[0.40,0.28,0.15], roughness=0.85, uv_mode="tile", uv_scale=2.0)
material "crossbar_wood" (color=[0.45,0.30,0.18], roughness=0.85)
material "insulator_grey" (color=[0.60,0.58,0.55], roughness=0.60, metallic=0.3)
material "wire_dark" (color=[0.15,0.15,0.18], roughness=0.85)
scene {
  cylinder "pole" (radius=0.08, height=6.00, segments=10, mat="pole_wood", pos=[0, 3.00, 0])
  // 1 crossbar near top
  box "crossbar" (size=[1.50, 0.06, 0.06], mat="crossbar_wood", pos=[0, 5.50, 0])
  // 3 insulators
  cylinder "ins_1" (radius=0.03, height=0.08, segments=8, mat="insulator_grey", pos=[-0.55, 5.57, 0])
  cylinder "ins_2" (radius=0.03, height=0.08, segments=8, mat="insulator_grey", pos=[ 0.00, 5.57, 0])
  cylinder "ins_3" (radius=0.03, height=0.08, segments=8, mat="insulator_grey", pos=[ 0.55, 5.57, 0])
  // 1 wire (horizontal between insulators)
  cylinder "wire" (radius=0.005, height=1.10, segments=6, mat="wire_dark", pos=[0, 5.62, 0], rot=[0, 0, 90], tags="floating")
  // Transformer (small box on pole)
  box "transformer" (size=[0.25, 0.40, 0.20], mat="crossbar_wood", pos=[0, 4.50, 0.10], tags="floating")
}
