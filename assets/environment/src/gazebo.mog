  box "rail_1" (size=[3.00, 0.04, 0.04], mat="wood_oak", pos=[0, 1.00, 1.50], tags="floating")
  box "rail_2" (size=[3.00, 0.04, 0.04], mat="wood_oak", pos=[0, 1.00, -1.50], tags="floating")
  box "rail_3" (size=[0.04, 0.04, 3.00], mat="wood_oak", pos=[1.50, 1.00, 0], tags="floating")
  box "rail_4" (size=[0.04, 0.04, 3.00], mat="wood_oak", pos=[-1.50, 1.00, 0], tags="floating")
}
