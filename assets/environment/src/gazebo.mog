material "concrete" (color=[0.55, 0.53, 0.50], roughness=0.90)
scene {
  slab "base" (size=[4.0, 0.10, 4.0], mat="concrete", pos=[0, 0.05, 0])
  cylinder "post_1" (radius=0.08, height=2.50, segments=8, mat="wood_oak", pos=[1.50, 1.25, 1.50])
  cylinder "post_2" (radius=0.08, height=2.50, segments=8, mat="wood_oak", pos=[-1.50, 1.25, 1.50])
  cylinder "post_3" (radius=0.08, height=2.50, segments=8, mat="wood_oak", pos=[1.50, 1.25, -1.50])
  cylinder "post_4" (radius=0.08, height=2.50, segments=8, mat="wood_oak", pos=[-1.50, 1.25, -1.50])
