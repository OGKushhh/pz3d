// school_bus.mog — Simplified school bus (static, non-driveable)
meta (name="school_bus", description="Simplified yellow school bus (static prop)", tags=["environment","bus","school","vehicle_prop","tier1"], mogen_version="0.1.12")
material "bus_yellow" (color=[0.85,0.65,0.15], roughness=0.50, metallic=0.3)
material "window_glass" (color=[0.30,0.40,0.50], transmission=0.40, roughness=0.10)
material "tire_black" (color=[0.08,0.08,0.08], roughness=0.85)
material "trim_dark" (color=[0.15,0.15,0.18], roughness=0.50, metallic=0.6)
material "bumper_chrome" (color=[0.75,0.75,0.78], metallic=0.90, roughness=0.15)
material "asphalt" (color=[0.18,0.18,0.20], roughness=0.95)
scene {
  slab "ground" (size=[12.0, 0.04, 4.0], mat="asphalt", pos=[0, 0.02, 0])
  // Body (long rounded box)
  rounded_box "body" (size=[8.00, 2.20, 2.40], radius=0.15, mat="bus_yellow", pos=[0, 1.60, 0])
  // Window strip (row of windows along both sides)
  box "windows_l" (size=[7.00, 0.60, 0.02], mat="window_glass", pos=[0, 1.90, 1.21], tags="floating")
  box "windows_r" (size=[7.00, 0.60, 0.02], mat="window_glass", pos=[0, 1.90, -1.21], tags="floating")
  // Front windshield
  box "windshield" (size=[0.04, 0.80, 2.00], mat="window_glass", pos=[-4.01, 1.80, 0], tags="floating")
  // Front grille + bumper
  box "grille" (size=[0.04, 0.40, 2.00], mat="trim_dark", pos=[-4.01, 1.20, 0], tags="floating")
  box "front_bumper" (size=[0.10, 0.15, 2.30], mat="bumper_chrome", pos=[-4.10, 0.75, 0], tags="floating")
  box "rear_bumper" (size=[0.10, 0.15, 2.30], mat="bumper_chrome", pos=[ 4.10, 0.75, 0], tags="floating")
  // 4 wheels
  cylinder "wheel_fl" (radius=0.40, height=0.25, segments=16, mat="tire_black", pos=[-2.50, 0.40, 1.20], rot=[0,0,90])
  cylinder "wheel_fr" (radius=0.40, height=0.25, segments=16, mat="tire_black", pos=[-2.50, 0.40, -1.20], rot=[0,0,90])
  cylinder "wheel_bl" (radius=0.40, height=0.25, segments=16, mat="tire_black", pos=[ 2.50, 0.40, 1.20], rot=[0,0,90])
  cylinder "wheel_br" (radius=0.40, height=0.25, segments=16, mat="tire_black", pos=[ 2.50, 0.40, -1.20], rot=[0,0,90])
  // Stop sign arm (folded against side)
  box "stop_arm" (size=[0.50, 0.50, 0.03], mat="bus_yellow", pos=[3.50, 1.50, 1.22], tags="floating")
}
