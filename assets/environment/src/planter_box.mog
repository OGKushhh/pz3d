// planter_box.mog
meta (name="planter_box", description="Wooden planter with dirt and small plant", tags=["environment","planter","garden","tier1"], mogen_version="0.1.12")
material "wood_oak" (color=[0.45,0.28,0.15], roughness=0.80, uv_mode="tile", uv_scale=2.0)
material "dirt_brown" (color=[0.35,0.22,0.12], roughness=0.95)
material "plant_green" (color=[0.25,0.45,0.18], roughness=0.85)
material "plant_dark" (color=[0.15,0.32,0.12], roughness=0.85)
scene {
  // Planter box (open-top: 4 walls + bottom)
  solid "box" (mat="wood_oak", cleanup="coplanar") {
    box "wall_front" (size=[0.60, 0.45, 0.03], pos=[0, 0.225, 0.185])
    box "wall_back" (size=[0.60, 0.45, 0.03], pos=[0, 0.225, -0.185])
    box "wall_left" (size=[0.03, 0.45, 0.40], pos=[-0.285, 0.225, 0])
    box "wall_right" (size=[0.03, 0.45, 0.40], pos=[ 0.285, 0.225, 0])
    box "bottom" (size=[0.55, 0.03, 0.35], pos=[0, 0.015, 0])
  }
  // Dirt (fills the planter)
  slab "dirt" (size=[0.50, 0.06, 0.30], mat="dirt_brown", pos=[0, 0.35, 0], tags="floating")
  // Small plant (3 small spheres for foliage)
  icosphere "foliage_1" (radius=0.08, subdivisions=2, mat="plant_green", pos=[-0.10, 0.45, 0.05], tags="floating")
  icosphere "foliage_2" (radius=0.07, subdivisions=2, mat="plant_dark", pos=[0.10, 0.44, -0.05], tags="floating")
  icosphere "foliage_3" (radius=0.06, subdivisions=2, mat="plant_green", pos=[0, 0.48, 0.08], tags="floating")
}
