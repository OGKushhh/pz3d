// wood_fence_post.mog
meta (name="wood_fence_post", description="Single wooden fence post", tags=["environment","fence","post","wood","tier1"], mogen_version="0.1.12")
material "wood_dark" (color=[0.30,0.18,0.10], roughness=0.80)
material "wood_oak" (color=[0.45,0.28,0.15], roughness=0.75)
scene {
  // Post (vertical box)
  box "post" (size=[0.10, 1.20, 0.10], mat="wood_dark", pos=[0, 0.60, 0])
  // Post cap (pyramid on top)
  pyramid "cap" (radius=0.08, height=0.05, sides=4, mat="wood_dark", pos=[0, 1.225, 0], rot=[0, 45, 0])
}
