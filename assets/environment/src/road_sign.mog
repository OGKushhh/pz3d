// road_sign.mog — Tier 1 environment prop — v2 SIMPLIFIED
// Standard road sign: post + sign panel (diamond, blank — no border pieces).
// Simplified per user feedback: removed border pieces (alignment was bad).
// Target: 150 tris (Low-preset LOD0). Actual: ~20 tris.
// Dimensions: 0.60m panel wide × 1.80m post tall.

meta (
  name          = "road_sign",
  description   = "Standard road sign with post and diamond panel (simplified, no borders)",
  tags          = ["environment", "sign", "road", "urban", "tier1"],
  mogen_version = "0.1.12"
)

material "post_metal" (color=[0.30, 0.32, 0.35], roughness=0.50, metallic=0.7)
material "sign_yellow" (color=[0.85, 0.75, 0.20], roughness=0.50, emissive=[0.3, 0.25, 0.05], emissive_strength=0.3)

scene {
  // === POST (vertical I-beam style — use a thin box) ===
  box "post" (size=[0.06, 1.50, 0.10], mat="post_metal", pos=[0, 0.75, 0])

  // === POST BASE (small footer at ground) ===
  box "base" (size=[0.15, 0.05, 0.18], mat="post_metal", pos=[0, 0.025, 0])

  // === SIGN PANEL (diamond shape — single box rotated 45° around Z) ===
  // Simplified: just the panel, no border pieces
  box "panel" (size=[0.50, 0.50, 0.03], mat="sign_yellow", pos=[0, 1.65, 0.05], rot=[0, 0, 45])
}
