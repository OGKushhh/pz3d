# Force LF for all text files across platforms
* text=auto eol=lf

# Explicitly mark text files that must be LF
*.gd     text eol=lf
*.tscn   text eol=lf
*.tres   text eol=lf
*.import text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.py     text eol=lf
*.cfg    text eol=lf

# Windows-only scripts keep CRLF (if you have any)
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary files — never touch
*.glb    binary
*.gltf   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.wav    binary
*.ogg    binary
*.zip    binary
*.ttf    binary
*.otf    binary